#!/usr/bin/env bash
# Safety net: if a test ever reaches a real launch, it prints instead of starting Claude.
# As wb-groom's judge (FAKE_CLAUDE_GROOM=DIR): copies every file in DIR into the first --add-dir
# (the judge's own dir; a planted file tests what wb-groom keeps from it), prints FAKE_CLAUDE_OUT
# (what lands in judge.json), then sleeps
# FAKE_CLAUDE_SLEEP seconds (a judge that wrote its answer and then hung) and exits FAKE_CLAUDE_RC
# (default 0). A decisions.json it copies gets the "backlog" field a judge that read all of
# backlog.tsv writes (its end marker and bead count, from the file's last line), unless it has one
# already; FAKE_CLAUDE_BACKLOG=skip leaves it out, =wrong writes a wrong marker.
# FAKE_CLAUDE_LOG: one JSON line per call: argv, cwd, CLAUDE_CONFIG_DIR (null when unset) and
# the names of the environment's variables; with FAKE_CLAUDE_LOG_VALUES=A,B also "values", those
# variables' values (null when unset).
if [ -n "${FAKE_CLAUDE_LOG:-}" ]; then
  python3 -c 'import json, os, sys; e = os.environ; v = [n for n in e.get("FAKE_CLAUDE_LOG_VALUES", "").split(",") if n]; print(json.dumps({"argv": sys.argv[1:], "cwd": os.getcwd(), "config": e.get("CLAUDE_CONFIG_DIR"), "env": sorted(e), "values": {n: e.get(n) for n in v}}))' "$@" >> "$FAKE_CLAUDE_LOG"
fi
if [ -z "${FAKE_CLAUDE_GROOM:-}" ]; then
  echo "FAKE-CLAUDE $*"
  exit 0
fi
run=""
while [ $# -gt 0 ]; do
  if [ "$1" = --add-dir ]; then run=$2; break; fi
  shift
done
for f in "$FAKE_CLAUDE_GROOM"/*; do
  [ -f "$f" ] && cp "$f" "$run/"
done
if [ -f "$run/decisions.json" ] && [ -f "$run/backlog.tsv" ] && [ "${FAKE_CLAUDE_BACKLOG:-}" != skip ]; then
  python3 - "$run" "${FAKE_CLAUDE_BACKLOG:-}" <<'PY'
import json, sys
run, how = sys.argv[1], sys.argv[2]
try:
    d = json.load(open(run + "/decisions.json"))
except ValueError:
    sys.exit(0)  # a test of an unreadable decisions.json keeps it as it is
end = open(run + "/backlog.tsv").read().splitlines()[-1].split()  # "# end TOKEN N beads"
if isinstance(d, dict) and "backlog" not in d:
    d["backlog"] = {"end": "not-the-marker" if how == "wrong" else end[2], "beads": int(end[3])}
    json.dump(d, open(run + "/decisions.json", "w"))
PY
fi
[ -z "${FAKE_CLAUDE_OUT:-}" ] || printf '%s\n' "$FAKE_CLAUDE_OUT"
[ -z "${FAKE_CLAUDE_SLEEP:-}" ] || sleep "$FAKE_CLAUDE_SLEEP"
exit "${FAKE_CLAUDE_RC:-0}"

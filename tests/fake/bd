#!/usr/bin/env bash
# Fake bd for tests.
# With FAKE_BD_DIR set, behaviour comes from files in it:
#   calls             incremented on every invocation (retry tests count it)
#   stdout.N, stdout  what call N (or any call) prints
#   stderr            printed to stderr
#   rc                exit code (default 0)
#   sleep             seconds to sleep first, in a child process (timeout tests)
#   closed            what a --closed-after read prints (the 30-day flow); not counted in calls
# Without FAKE_BD_DIR, it prints $PWD/.beads/fake.json (screen tests: one store per space),
# except:
#   --closed-after  prints $PWD/.beads/fake-closed.json, or [] without one
#   show ID   walks up to .beads/fake.json and prints [that bead], or exits 1;
#             FAKE_BD_SLEEP sleeps first, FAKE_BD_WARN prints a Warning line first
#             (FAKE_BD_WARN=bracket: a '[warn] …' line, which looks like JSON)
#   update    sleeps $FAKE_BD_UPDATE_SLEEP, exits $FAKE_BD_UPDATE_RC (default 0)
#   list      with FAKE_BD_HIDE_CLOSED set, leaves out closed beads unless --all, as bd does
# FAKE_BD_STATEFUL=1 makes writes real against that same .beads/fake.json (wb-groom's apply and
# undo read back what they wrote): `update` handles --add-label, --remove-label, --append-notes,
# --notes, --set-metadata K=V, -p/--priority, -s/--status and --defer, `close ID --reason R` sets status closed with
# closed_at and close_reason and `undefer ID` opens it and drops defer_until; each bumps the
# bead's updated_at to a new second. As in bd (checked on a scratch store), a status other than
# closed drops closed_at and close_reason, and --defer D sets defer_until and status deferred
# (--defer= clears it and, from deferred, opens). A leading --sandbox is ignored.
#   FAKE_BD_UPDATE_FAIL_ID=ID   writes to that bead exit 1, changing nothing
#   FAKE_BD_REQUIRE_FILE=PATH   a write exits 9, changing nothing, unless PATH exists and is not empty
# FAKE_BD_LOG: every call's args are appended to it.
# FAKE_BD_ARGV_LOG: every call's argv, one JSON list per line (the log above flattens a newline).
set -u
[ -n "${FAKE_BD_LOG:-}" ] && echo "$*" >> "$FAKE_BD_LOG"
[ -n "${FAKE_BD_ARGV_LOG:-}" ] && python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "$@" >> "$FAKE_BD_ARGV_LOG"
[ "${1:-}" = --sandbox ] && shift
if [ -n "${FAKE_BD_STATEFUL:-}" ]; then
  case "${1:-}" in
    update|close|undefer)
      [ -z "${FAKE_BD_REQUIRE_FILE:-}" ] || [ -s "$FAKE_BD_REQUIRE_FILE" ] || { echo "Error: $FAKE_BD_REQUIRE_FILE not written yet" >&2; exit 9; }
      d=$PWD
      while [ ! -f "$d/.beads/fake.json" ] && [ "$d" != / ]; do d=$(dirname "$d"); done
      python3 - "$d/.beads" "${FAKE_BD_UPDATE_FAIL_ID:-}" "$@" <<'PY'
import json, sys
dotbeads, fail_id, cmd, bid, *rest = sys.argv[1:]
if bid == fail_id:
    print(f"Error: cannot update {bid}", file=sys.stderr)
    sys.exit(1)
path = dotbeads + "/fake.json"
beads = json.load(open(path))
b = next((x for x in beads if x["id"] == bid), None)
if b is None:
    print(f"Error: no issue found matching {bid!r}", file=sys.stderr)
    sys.exit(1)
labels = list(b.get("labels") or [])
i = 0
def val():
    global i
    a = rest[i]
    if "=" in a and a.startswith("--"):
        return a.split("=", 1)[1]
    i += 1
    return rest[i]
try: tick = int(open(dotbeads + "/fake-clock").read()) + 1
except OSError: tick = 1
open(dotbeads + "/fake-clock", "w").write(str(tick))
stamp = "2026-10-23T12:%02d:%02dZ" % divmod(tick, 60)
if cmd == "close": b["status"], b["closed_at"] = "closed", stamp
if cmd == "undefer": b["status"] = "open"; b.pop("defer_until", None)
while i < len(rest):
    a = rest[i]
    flag = a.split("=", 1)[0]
    if flag == "--add-label":
        v = val(); labels.append(v) if v not in labels else None
    elif flag == "--remove-label":
        v = val(); labels = [l for l in labels if l != v]
    elif flag == "--append-notes":
        v = val(); b["notes"] = (b["notes"] + "\n" if b.get("notes") else "") + v
    elif flag == "--notes":
        v = val()
        if v: b["notes"] = v
        else: b.pop("notes", None)
    elif flag in ("-p", "--priority"): b["priority"] = int(val().lstrip("P"))
    elif flag in ("-s", "--status"):
        b["status"] = val()
        if b["status"] != "closed": b.pop("closed_at", None); b.pop("close_reason", None)
    elif flag == "--defer":
        v = val()
        if v: b["defer_until"], b["status"] = v, "deferred"
        else:
            b.pop("defer_until", None)
            if b.get("status") == "deferred": b["status"] = "open"
    elif flag == "--reason": b["close_reason"] = val()
    elif flag == "--set-metadata":
        k, _, v = val().partition("="); b.setdefault("metadata", {})[k] = v
    else:
        print(f"fake bd: unsupported flag {a}", file=sys.stderr); sys.exit(2)
    i += 1
b["labels"] = labels
b["updated_at"] = stamp
json.dump(beads, open(path, "w"))
print(f"Updated {bid}")
PY
      exit $? ;;
  esac
fi
if [ -z "${FAKE_BD_DIR:-}" ]; then
  case "${1:-}" in
    show)
      [ -z "${FAKE_BD_SLEEP:-}" ] || sleep "$FAKE_BD_SLEEP"
      d=$PWD
      while [ ! -f "$d/.beads/fake.json" ] && [ "$d" != / ]; do d=$(dirname "$d"); done
      [ -f "$d/.beads/fake.json" ] || { echo "Error: no beads database found" >&2; exit 1; }
      case "${FAKE_BD_WARN:-}" in
        "") ;;
        bracket) echo "[warn] slow dolt" ;;
        *) echo "Warning: noisy" ;;
      esac
      python3 - "$d/.beads/fake.json" "$2" <<'PY'
import json, sys
beads = [b for b in json.load(open(sys.argv[1])) if b.get("id") == sys.argv[2]]
if not beads:
    print(f"Error: no issue found matching {sys.argv[2]!r}", file=sys.stderr)
    sys.exit(1)
print(json.dumps(beads))
PY
      exit $? ;;
    update) [ -z "${FAKE_BD_UPDATE_SLEEP:-}" ] || sleep "$FAKE_BD_UPDATE_SLEEP"
            exit "${FAKE_BD_UPDATE_RC:-0}" ;;
  esac
  case " $* " in
    *" --closed-after "*) if [ -f .beads/fake-closed.json ]; then cat .beads/fake-closed.json; else echo '[]'; fi; exit 0 ;;
  esac
  [ -f .beads/fake.json ] || exit 0
  case "${FAKE_BD_HIDE_CLOSED:+hide} $* " in
    "hide "*" --all "*|"hide "*" --status "*|"hide "*" -s "*|" "*) cat .beads/fake.json ;;
    *) python3 -c 'import json,sys; print(json.dumps([b for b in json.load(open(sys.argv[1])) if b.get("status") != "closed"]))' .beads/fake.json ;;
  esac
  exit 0
fi
d="$FAKE_BD_DIR"
case " $* " in
  *" --closed-after "*) if [ -f "$d/closed" ]; then cat "$d/closed"; else echo '[]'; fi; exit 0 ;;
esac
n=$(( $(cat "$d/calls" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$d/calls"
[ -f "$d/sleep" ] && sleep "$(cat "$d/sleep")"
[ -f "$d/stderr" ] && cat "$d/stderr" >&2
if [ -f "$d/stdout.$n" ]; then cat "$d/stdout.$n"; elif [ -f "$d/stdout" ]; then cat "$d/stdout"; fi
exit "$(cat "$d/rc" 2>/dev/null || echo 0)"

#!/usr/bin/env bash
# end-session — remove a session's worktree once its work is safe, for any
# space in spaces.toml. Spec: docs/specs/2026-10-18-session-scripts-design.md
set -euo pipefail
WB_HOME="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# shellcheck source=../lib/session.sh
. "$WB_HOME/lib/session.sh"

usage() {
  cat <<'EOF'
Usage: end-session [<worktree-path>] [--force | --if-merged] [--no-space] [--base=<branch>]

  <worktree-path>   default: the worktree you are in
  --force           skip the dirty, unpushed and before_end checks; keep the branch
  --if-merged       remove it only when its branch is merged and the bead claimed in
                    it is closed; otherwise keep everything and say why in one line.
                    What the launcher runs when Claude exits; prints no progress lines
  --no-space        go ahead though no space in spaces.toml claims this repo
                    (so no before_end check runs)
  --base=<branch>   the branch "merged" is checked against
                    (default: the repo's default branch)

Merged means the branch is in <branch>'s history, or gh reports a merged pull
request from it into <branch> whose head is exactly the worktree's HEAD (a
squash merge, whose commits never reach <branch> themselves).
EOF
}
die() { echo "end-session: $1" >&2; exit "${2:-2}"; }
# progress lines; --if-merged runs at every session's exit, where only the verdict is news
step() { [ "$IF_MERGED" = 1 ] || echo "$1"; }

FORCE=0; IF_MERGED=0; NO_SPACE=0; TARGET=""; BASE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1; shift ;;
    --if-merged) IF_MERGED=1; shift ;;
    --no-space) NO_SPACE=1; shift ;;
    --base=*) BASE=${1#*=}; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "end-session: unknown flag: $1" >&2; usage >&2; exit 2 ;;
    *) [ -z "$TARGET" ] || die "only one worktree path, got another: $1"
       TARGET=$1; shift ;;
  esac
done

[ "$FORCE" = 0 ] || [ "$IF_MERGED" = 0 ] || die "--force and --if-merged can't go together"

# ---- the worktree, and the main checkout it belongs to
[ -n "$TARGET" ] || TARGET=$PWD
[ -d "$TARGET" ] || die "no such folder: $TARGET"
TARGET=$(git -C "$TARGET" rev-parse --show-toplevel 2>/dev/null) || die "$TARGET is not in a git repo" 1
TARGET=$(cd "$TARGET" && pwd -P)
COMMON=$(git -C "$TARGET" rev-parse --path-format=absolute --git-common-dir)
MAIN=$(cd "$COMMON/.." && pwd -P)
[ "$TARGET" != "$MAIN" ] || die "refusing to remove the main checkout ($MAIN)" 1
REGISTERED=0
LIST=$(git -C "$MAIN" worktree list --porcelain)
while IFS= read -r line; do
  case "$line" in
    "worktree "*)
      if [ "$(cd "${line#worktree }" 2>/dev/null && pwd -P)" = "$TARGET" ]; then REGISTERED=1; fi ;;
  esac
done <<< "$LIST"
[ "$REGISTERED" = 1 ] || die "$TARGET is not a registered git worktree" 1
BRANCH=$(git -C "$TARGET" rev-parse --abbrev-ref HEAD)
[ "$BRANCH" != HEAD ] || die "the worktree is on a detached HEAD, so its branch is unknown" 1
step "→ worktree: $TARGET (branch: $BRANCH)"

# ---- its space: a worktree space on this repo, preferring the one whose key
# names the worktree (new-session makes <key>-<slug>). Fail closed: before_end
# may be the only thing between unverified work and its removal.
FOUND=0; FIRST_ROW=""; KEY_ROW=""
if ROWS="$(ws_rows)"; then
  while IFS= read -r r; do
    [ -n "$r" ] || continue
    ws_split "$r"
    [ "$S_WORKTREES" = 1 ] || continue
    top=$(git -C "$S_ROOT" rev-parse --show-toplevel 2>/dev/null) || continue
    [ "$(cd "$top" && pwd -P)" = "$MAIN" ] || continue
    [ -n "$FIRST_ROW" ] || FIRST_ROW=$r
    case "$(basename "$TARGET")" in "$S_KEY"-*) KEY_ROW=$r; break ;; esac
  done <<< "$ROWS"
  ROW=${KEY_ROW:-$FIRST_ROW}
  if [ -n "$ROW" ]; then ws_split "$ROW"; FOUND=1; fi
  if [ "$FOUND" = 1 ]; then :
  elif [ "$NO_SPACE" = 1 ] || [ "$FORCE" = 1 ]; then
    echo "end-session: no space in spaces.toml claims $MAIN; no before_end check ran." >&2
  else
    # Fail closed: a lookup that misses (a moved root, a typo) would otherwise
    # skip the space's gate with only a warning.
    die "no worktree space in spaces.toml claims $MAIN, so no before_end check can run. Fix the space's root, or use --no-space." 1
  fi
elif [ "$FORCE" = 1 ]; then
  echo "end-session: could not read spaces.toml; going ahead because of --force." >&2
else
  die "could not read spaces.toml (see above), so this space's before_end check can't run. Fix the config, or use --force." 1
fi

# where the space's project and beads live, in the main checkout
PREFIX=""
if [ "$FOUND" = 1 ]; then PREFIX=$(git -C "$S_ROOT" rev-parse --show-prefix); PREFIX=${PREFIX%/}; fi
SOURCE="$MAIN${PREFIX:+/$PREFIX}"

# ---- its bead, closed or not: the one new-session linked to this worktree (metadata, else claim note)
BEAD=$("$WB_HOME/bin/wb-backlog" claimed "$SOURCE" "$TARGET" --status 2>/dev/null) || BEAD=""
BEAD_STATUS=${BEAD#*$'\t'}; BEAD=${BEAD%%$'\t'*}
if [ -n "$BEAD" ]; then step "→ bead: $BEAD"
else step "→ no bead names this worktree; nothing will be noted."; fi
note_bead() {   # append, never replace: the notes hold the claim
  [ -n "$BEAD" ] || return 0
  (cd "$SOURCE" && ws_timeout "${WB_BD_WRITE_TIMEOUT:-30}" "${WB_BD:-bd}" update "$BEAD" \
     --append-notes "$1" </dev/null >/dev/null) \
    || echo "  warning: couldn't note the close-out on $BEAD." >&2
}

[ -n "$BASE" ] || BASE=$(ws_default_branch "$MAIN")
HAS_ORIGIN=0
if git -C "$MAIN" remote get-url origin >/dev/null 2>&1; then HAS_ORIGIN=1; fi
REF=$BASE; if [ "$HAS_ORIGIN" = 1 ]; then REF="origin/$BASE"; fi

# ---- checks
NAME=$(basename "$TARGET")
# --if-merged: a clean, pushed, unmerged branch would otherwise go (its pull request may be
# waiting on the owner's yes, and the worktree holds the session's conversation). A worktree
# with no commits reads as merged too, so the closed bead is what says the work is done. The
# local checks come first: most exits are mid-work, and they need no fetch or gh call.
if [ "$IF_MERGED" = 1 ]; then
  [ -z "$(git -C "$TARGET" status --porcelain)" ] || die "kept $NAME: it has uncommitted changes." 1
  [ -n "$BEAD" ] || die "kept $NAME: no bead names it, so nothing says its work is done (end-session ends it anyway)." 1
  [ "$BEAD_STATUS" = closed ] || die "kept $NAME: its bead $BEAD is ${BEAD_STATUS:-of unknown status}." 1
fi
if [ "$FORCE" = 0 ] && [ -n "$(git -C "$TARGET" status --porcelain)" ]; then
  echo "end-session: the worktree has uncommitted changes. Commit them, or use --force:" >&2
  git -C "$TARGET" status --short >&2
  exit 1
fi

NOTHING=0   # every commit already on the base: nothing to push or verify
if [ "$FORCE" = 0 ]; then
  if [ "$HAS_ORIGIN" = 1 ]; then git -C "$TARGET" fetch --quiet origin "$BASE" 2>/dev/null || true; fi
  if git -C "$TARGET" merge-base --is-ancestor HEAD "$REF" 2>/dev/null; then
    NOTHING=1; step "→ no commits beyond $REF — nothing to push or verify"
  fi
fi

# A squash merge leaves the branch's commits off the base, so ancestry says
# "unmerged" forever, the before_end marker for this SHA never comes, and GitHub
# may have deleted the remote branch. A merged pull request whose head is exactly
# this HEAD says the work is on the base: nothing to push or verify.
SQUASH=""   # "PR #N" when so
if [ "$FORCE" = 0 ] && [ "$NOTHING" = 0 ] && [ "$HAS_ORIGIN" = 1 ]; then
  ACCOUNT=""; [ "$FOUND" = 1 ] && ACCOUNT=$S_GH_ACCOUNT
  if SQUASH=$("$WB_HOME/lib/wb_merged.py" "$TARGET" "$BRANCH" "$BASE" \
                "$(git -C "$TARGET" rev-parse HEAD)" ${ACCOUNT:+"$ACCOUNT"} 2>/dev/null); then
    NOTHING=1; step "→ squash-merged into $BASE by $SQUASH at this HEAD — nothing to push or verify"
  else
    SQUASH=""
  fi
fi

if [ "$IF_MERGED" = 1 ] && [ "$NOTHING" = 0 ]; then
  die "kept $NAME: '$BRANCH' is not merged into $BASE yet." 1
fi

if [ "$FORCE" = 0 ] && [ "$NOTHING" = 0 ] && [ "$HAS_ORIGIN" = 1 ]; then
  git -C "$TARGET" fetch --quiet origin "$BRANCH" 2>/dev/null || true
  LOCAL=$(git -C "$TARGET" rev-parse HEAD)
  REMOTE=$(git -C "$TARGET" rev-parse --verify --quiet "origin/$BRANCH" || true)
  [ -n "$REMOTE" ] || die "'$BRANCH' is not pushed to origin (use --force to override)" 1
  [ "$LOCAL" = "$REMOTE" ] || die "'$BRANCH' has unpushed commits (origin at ${REMOTE:0:10}, local at ${LOCAL:0:10})" 1
fi
if [ "$FORCE" = 0 ] && [ "$NOTHING" = 0 ] && [ "$HAS_ORIGIN" = 0 ]; then
  step "→ no origin remote, so there is nothing to push to; skipping the push check (an unmerged branch is kept)"
fi

# the hooks' variables. Physical paths, worked out now: after removal the
# folders are gone and can no longer be resolved.
if [ "$FOUND" = 1 ]; then
  PROJECT="$TARGET${PREFIX:+/$PREFIX}"
  if [ -d "$PROJECT" ]; then PROJECT=$(cd "$PROJECT" && pwd -P); else PROJECT=$TARGET; fi
  export WB_SPACE="$S_KEY" WB_WORKTREE="$TARGET" WB_PROJECT="$PROJECT" \
         WB_SOURCE="$SOURCE" WB_BRANCH="$BRANCH" WB_BEAD="$BEAD"
fi

if [ "$FOUND" = 1 ] && [ -n "$S_BEFORE_END" ] && [ "$FORCE" = 0 ] && [ "$NOTHING" = 0 ]; then
  WB_SHA=$(git -C "$TARGET" rev-parse HEAD); export WB_SHA
  step "→ before_end: $S_BEFORE_END"
  ws_run_hook "$S_BEFORE_END" "$PROJECT" \
    || die "before_end failed, so the worktree stays. Fix what it says, or use --force." 1
fi

# Stashes belong to the repo, not the worktree, so removal keeps them; say so,
# since they're easy to forget once the folder is gone.
STASHES=$(git -C "$MAIN" stash list --format=%gs | grep -c -E "^(WIP on|On) $BRANCH:" || true)
if [ "$STASHES" = 1 ]; then echo "→ note: 1 stash made on $BRANCH is kept in the repo (git stash list)"
elif [ "$STASHES" -gt 1 ]; then echo "→ note: $STASHES stashes made on $BRANCH are kept in the repo (git stash list)"; fi

# ---- remove, then tidy the branch
step "→ removing worktree $TARGET"
cd "$MAIN"   # the worktree may be our own folder
if [ "$FORCE" = 1 ]; then git -C "$MAIN" worktree remove --force "$TARGET"
else git -C "$MAIN" worktree remove "$TARGET"; fi

# after_end: cleanup that lives outside the folder (say, local databases keyed
# on the worktree's path). It runs on every path, --force included, since
# removal strands such things whatever the reason. The folder is gone, so it
# runs in the main checkout's project folder. Fail-open: the worktree is
# already removed, so a failing or hung hook only warns.
if [ "$FOUND" = 1 ] && [ -n "$S_AFTER_END" ]; then
  step "→ after_end: $S_AFTER_END"
  if ! ws_timeout "${WB_AFTER_END_TIMEOUT:-60}" sh -c 'cd "$1" && sh -c "$2"' sh "$SOURCE" "$S_AFTER_END"; then
    echo "  warning: after_end failed; the worktree is removed anyway. Clean up by hand if it matters." >&2
  fi
fi
if [ "$FORCE" = 1 ]; then
  note_bead "Session ended (forced): worktree removed; branch $BRANCH kept, unchecked."
  echo "✓ session ended (forced). Branch '$BRANCH' kept — check it by hand."
  exit 0
fi
if [ "$HAS_ORIGIN" = 1 ]; then git -C "$MAIN" fetch --quiet origin "$BASE" 2>/dev/null || true; fi
MERGED=0
if [ -n "$SQUASH" ]; then MERGED=1; fi
if git -C "$MAIN" merge-base --is-ancestor "$BRANCH" "$BASE" 2>/dev/null; then MERGED=1; fi
if [ "$HAS_ORIGIN" = 1 ] && git -C "$MAIN" merge-base --is-ancestor "$BRANCH" "origin/$BASE" 2>/dev/null; then MERGED=1; fi
if [ "$MERGED" = 1 ]; then
  # -D, not -d: ancestry (or the squash PR) is proven above, and -d re-checks against the branch's
  # own (possibly stale) upstream.
  TIP=$(git -C "$MAIN" rev-parse "$BRANCH")
  git -C "$MAIN" branch -D "$BRANCH" >/dev/null
  HOW="merged into $BASE"; [ -z "$SQUASH" ] || HOW="squash-merged into $BASE by $SQUASH"
  note_bead "Session ended: worktree removed; branch $BRANCH $HOW at ${TIP:0:10} and deleted."
  echo "✓ session ended. Branch '$BRANCH' is $HOW and was deleted."
else
  note_bead "Session ended: worktree removed; branch $BRANCH kept, not merged into $BASE."
  echo "✓ session ended. Branch '$BRANCH' is not merged into $BASE, so it was kept."
  echo "  Delete it later with: $(ws_quote git -C "$MAIN" branch -d "$BRANCH")"
fi

#!/usr/bin/env python3
"""wb-backlog — one space's live beads, read through bd.

  wb-backlog list ROOT [--snapshot FILE] [--flow FILE]
      TSV, best first: id, short id, mark (○ open / ◐ in progress), P<n>,
      section (NOW / NEXT / - / ICEBOX), title, parent, worktree from the claim
      notes, the parent's title, days idle (a claim untouched for over IDLE_DAYS, or -),
      start here (rank 1-3 and why, or -; see picks()),
      attention (rank and why for a bead labelled `attention`, or -; see attention()).
      --flow writes one line, the last FLOW_DAYS' beads created vs closed, to FILE;
      nothing when the closed beads can't be read.
      Exits non-zero when there is nothing to list; the code says why (STATES).
  wb-backlog summary ROOT      one line of counts for screen 1; always exits 0
  wb-backlog claimed ROOT PATH the bead whose current claim note names the
      worktree at PATH (end-session's way back to the bead), the one updated
      last when several do; exits 1 if none
  wb-backlog preview FILE ID [QUERY]
      the preview pane for one bead, from a snapshot, with QUERY's words
      highlighted in the title and description (lib/wb_search.py)

Order: wave:1, then wave:2, then everything else, then the icebox (label
`icebox`, whatever its wave); priority within each. Closed and deferred beads are hidden.
"""
import datetime
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import wb_search  # noqa: E402  (lives in lib/; realpath, since install.sh links bin/ elsewhere)

TIMEOUT = float(os.environ.get("WB_BD_TIMEOUT", "10"))  # counts fill in after the screen draws; a big store under parallel load takes ~3s
BD = os.environ.get("WB_BD", "bd")
HIDDEN = {"closed", "deferred"}
ICEBOX = "icebox"
ATTENTION = "attention"  # set by the weekly grooming; the reason rides in the notes
ATTENTION_NOTE_RE = re.compile(r"^attention: (.+)$", re.M)
IDLE_DAYS = 7  # a claim untouched this long is likely a forgotten tab
PICKS = 3  # start here: few enough to choose from at a glance
FLOW_DAYS = 30
DONE_RE = re.compile(r"^[\s>*#-]*(?:\*\*)?\s*done when\b", re.I | re.M)  # the "Done when …" line beads use
WORKTREE_RE = re.compile(r"worktree at (/[^)\n]+)\)")  # paths may contain spaces
# state -> (list exit code, summary text)
STATES = {
    "no-bd": (20, "(bd not installed)"),
    "no-store": (21, "(no bead store)"),
    "unreadable": (22, "(no readable beads)"),
    "unavailable": (23, "(bd unavailable)"),
    "empty": (24, "0 open"),  # screen 1 has no ctrl-r; screen 2 says how to re-check
}


class BdError(Exception):
    def __init__(self, state):
        super().__init__(state)
        self.state = state


def run_bd(root, *extra):
    try:
        p = subprocess.Popen([BD, "list", "-n", "0", "--json", *extra], cwd=root, text=True,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             start_new_session=True)
    except OSError:
        raise BdError("unavailable")
    try:
        out, err = p.communicate(timeout=TIMEOUT)
    except subprocess.TimeoutExpired:
        # Kill the whole group: a child still holding the pipe would make
        # communicate() wait for it.
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass  # it finished just as the timeout hit
        try:
            p.communicate(timeout=1)
        except subprocess.TimeoutExpired:
            pass  # a child in its own session still holds the pipe; leave it
        raise BdError("unavailable")
    if p.returncode != 0:
        raise BdError("unreadable" if "no beads database found" in out + err else "unavailable")
    start = re.search(r"^\[", out, re.M)  # bd can print 'Warning: …' lines first
    if not start:
        raise BdError("unavailable")
    try:
        data = json.loads(out[start.start():])
    except json.JSONDecodeError:
        raise BdError("unavailable")
    if not isinstance(data, list) or not all(isinstance(b, dict) for b in data):
        raise BdError("unavailable")
    return data


def has_store(root):
    """A bead store in ROOT or a parent, up to the top of ROOT's git repo. bd itself
    walks up (a space's root can be a subfolder of the repo that holds .beads), but a
    store above the repo, like ~/.beads, belongs to someone else. Outside any
    repo the walk stops below $HOME. A store is a .beads with bd's config.yaml or
    metadata.json, as in lib/session.sh: a .beads holding only old exports isn't."""
    home = os.path.abspath(os.path.expanduser("~"))
    d = os.path.abspath(root)
    while d != home or d == os.path.abspath(root):
        if any(os.path.isfile(os.path.join(d, ".beads", f)) for f in ("config.yaml", "metadata.json")):
            return True
        if os.path.exists(os.path.join(d, ".git")) or os.path.dirname(d) == d:
            return False
        d = os.path.dirname(d)
    return False


def read(root):
    """(state, every bead bd returned). state is 'ok' or a key of STATES."""
    if shutil.which(BD) is None:
        return "no-bd", []
    if not has_store(root):
        return "no-store", []
    try:
        data = run_bd(root)
        if not data:  # a locked store has answered [] with exit 0; look once more
            data = run_bd(root)
    except BdError as e:
        return e.state, []
    return ("ok" if data else "empty"), data


def live(data):
    return [b for b in data if b.get("status") not in HIDDEN]


def flaggable(data):
    """Beads that can need attention: live ones, and deferred ones (a flag put on a deferred
    bead would otherwise show nowhere). Closed ones never."""
    return [b for b in data if b.get("status") != "closed"]


def section(b):
    if ICEBOX in (b.get("labels") or []):
        return "ICEBOX"
    waves = [int(l[5:]) for l in (b.get("labels") or []) if re.fullmatch(r"wave:\d+", str(l))]
    return {1: "NOW", 2: "NEXT"}.get(min(waves) if waves else None, "-")


def priority(b):
    p = b.get("priority")
    return p if isinstance(p, int) else 9


def ordered(beads):
    rank = {"NOW": 0, "NEXT": 1, "ICEBOX": 3}
    return sorted(beads, key=lambda b: (rank.get(section(b), 2), priority(b), str(b.get("id", ""))))


def age(stamp):
    """Whole days since an ISO timestamp, or None if it isn't one."""
    try:
        t = datetime.datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
        return (datetime.datetime.now(datetime.timezone.utc) - t).days
    except (TypeError, ValueError):
        return None


def idle(b):
    """Whole days since a claimed bead was last touched, when that's over IDLE_DAYS."""
    if b.get("status") != "in_progress":
        return None
    days = age(b.get("updated_at"))
    return days if days is not None and days > IDLE_DAYS else None


def has_done_line(b):
    return bool((b.get("acceptance_criteria") or "").strip()) or bool(DONE_RE.search(b.get("description") or ""))


def picks(beads):
    """{id: "rank why"} for the start-here few: ready beads (no icebox, epic or
    open blocker; bd leaves closed beads out, so a blocker it didn't return is
    closed), a fresh claim first so work in hand gets finished, then NOW, NEXT,
    priority, a done line, and how many beads each would unblock. At most one
    fresh claim, so the picks aren't a row of open tabs. Attention beads have
    their own field. None in a backlog short enough to see whole."""
    ids = {b.get("id") for b in beads}
    blockers = {b.get("id"): {d.get("depends_on_id") for d in b.get("dependencies") or []
                              if d.get("type") == "blocks"} & ids for b in beads}
    unblocks = {}
    for bs in blockers.values():
        for i in bs:
            unblocks[i] = unblocks.get(i, 0) + 1
    if sum(section(b) != "ICEBOX" for b in beads) <= PICKS:
        return {}
    ready = [b for b in beads if section(b) != "ICEBOX" and b.get("issue_type") != "epic"
             and ATTENTION not in (b.get("labels") or [])
             and b.get("status") != "blocked" and not blockers[b.get("id")]]

    def resume(b):
        days = age(b.get("updated_at"))
        return b.get("status") == "in_progress" and days is not None and days <= IDLE_DAYS

    rank = {"NOW": 0, "NEXT": 1}
    ready.sort(key=lambda b: (not resume(b), rank.get(section(b), 2), priority(b),
                              not has_done_line(b), -unblocks.get(b.get("id"), 0), str(b.get("id", ""))))
    seen_claim = False
    chosen = []
    for b in ready:
        if resume(b):
            if seen_claim:
                continue
            seen_claim = True
        chosen.append(b)
    out = {}
    for n, b in enumerate(chosen[:PICKS], 1):
        why = (["resume"] if resume(b) else []) + ([section(b)] if section(b) in rank else [])
        why.append(f"P{b['priority']}" if isinstance(b.get("priority"), int) else "P-")
        if unblocks.get(b.get("id")):
            why.append(f"unblocks {unblocks[b.get('id')]}")
        if not has_done_line(b):
            why.append("shape first")  # nothing says what done looks like yet
        out[b.get("id")] = f"{n} " + " · ".join(why)
    return out


def attention(beads):
    """{id: "n reason"} for beads labelled `attention`, icebox or not, n by
    priority then id. The reason is the last `attention: …` line in the notes."""
    flagged = sorted((b for b in beads if ATTENTION in (b.get("labels") or [])),
                     key=lambda b: (priority(b), str(b.get("id", ""))))
    out = {}
    for n, b in enumerate(flagged, 1):
        why = ATTENTION_NOTE_RE.findall(b.get("notes") or "")
        out[b.get("id")] = f"{n} {why[-1].strip() if why else ATTENTION}" + (
            " · deferred" if b.get("status") == "deferred" else "")
    return out


def read_closed(root, out):
    """Beads closed in the last FLOW_DAYS, into out["closed"]; left unset if bd fails."""
    since = (datetime.date.today() - datetime.timedelta(days=FLOW_DAYS)).isoformat()
    try:
        out["closed"] = [b for b in run_bd(root, "--all", "--closed-after", since)
                         if b.get("status") == "closed"]
    except BdError:
        pass


def write_flow(path, data, closed):
    """A bead created in the window and since closed was closed in it too, so
    created = live ones created in it + closed ones created in it."""
    new = lambda b: (lambda d: d is not None and d < FLOW_DAYS)(age(b.get("created_at")))
    made = sum(map(new, data)) + sum(map(new, closed))
    if not made and not closed:
        return  # nothing to say (or a store without timestamps)
    net = made - len(closed)
    with open(path + ".part", "w") as f:
        f.write(f"last {FLOW_DAYS} days: {'+' if net > 0 else ''}{net} · {made} created, {len(closed)} closed\n")
    os.replace(path + ".part", path)


def clean(v):
    v = re.sub(r"[\t\r\n]+", " ", str(v or "")).strip()
    return v or "-"


def worktree(b):
    found = WORKTREE_RE.findall(b.get("notes") or "")
    return found[-1] if found else "-"  # notes are appended to, so the last claim is current


def cmd_list(root, snapshot=None, flow=None):
    found = {}
    reader = None
    if flow and shutil.which(BD) and has_store(root):  # read alongside the main list: it costs as much
        reader = threading.Thread(target=read_closed, args=(root, found))
        reader.start()
    state, data = read(root)
    if reader:
        reader.join()
        if state == "ok" and "closed" in found:
            write_flow(flow, data, found["closed"])
    if snapshot and data:  # write-then-rename: the preview may be reading it during a ctrl-r reload
        with open(snapshot + ".part", "w") as f:
            json.dump({b.get("id"): b for b in data}, f, ensure_ascii=False)
        os.replace(snapshot + ".part", snapshot)
    if state != "ok":
        return STATES[state][0]
    titles = {b.get("id"): b.get("title") for b in data}  # all of them: a parent may be closed
    start = picks(live(data))
    flagged = attention(flaggable(data))
    visible = {id(b) for b in live(data)}
    shown = [b for b in data if id(b) in visible or b.get("id") in flagged]
    for b in ordered(shown):
        bid = str(b.get("id", ""))
        mark = "◐" if b.get("status") == "in_progress" else "○"
        prio = f"P{b['priority']}" if isinstance(b.get("priority"), int) else "P-"
        print("\t".join(clean(x) for x in (bid, bid.rsplit("-", 1)[-1], mark, prio,
                                            section(b), b.get("title"), b.get("parent"),
                                            worktree(b), titles.get(b.get("parent")), idle(b),
                                            start.get(b.get("id")), flagged.get(b.get("id")))))
    return 0


def cmd_claimed(root, path):
    state, data = read(root)
    want = os.path.realpath(path)
    hits = [b for b in data or [] if worktree(b) != "-" and os.path.realpath(worktree(b)) == want]
    if not hits:
        return 1
    # after "continue here" (wb-focus) the old and the new bead both name the
    # worktree; the new one was noted last, so it was updated last
    print(max(hits, key=lambda b: str(b.get("updated_at") or "")).get("id", ""))
    return 0


def cmd_summary(root):
    state, data = read(root)
    if state != "ok":
        print(STATES[state][1])
        return 0
    beads = live(data)
    ice = sum(section(b) == "ICEBOX" for b in beads)
    claimed = sum(b.get("status") == "in_progress" for b in beads)
    stale = sum(idle(b) is not None for b in beads)
    claims = f"claimed {claimed}" + (f" ({stale} idle)" if stale else "")
    now = sum(section(b) == "NOW" for b in beads)
    nxt = sum(section(b) == "NEXT" for b in beads)
    flagged = len(attention(flaggable(data)))
    lead = f"! {flagged} need attention · " if flagged else ""
    if now or nxt:
        print(lead + f"NOW {now} · NEXT {nxt} · {claims}" + (f" · icebox {ice}" if ice else ""))
    else:
        print(lead + f"open {len(beads) - ice} · " + (f"icebox {ice} · " if ice else "") + claims)
    return 0


def cmd_preview(snapshot, bead_id, query=""):
    if bead_id == "":  # a section header or message row
        return 0
    if bead_id == "-":
        print("✦ Start Claude here and shape a new idea into a bead.")
        return 0
    try:
        with open(snapshot) as f:
            beads = json.load(f)
    except (OSError, ValueError):
        print("(no details yet — ctrl-r to re-read)")
        return 0
    b = beads.get(bead_id)
    if not b:
        print(f"{bead_id}: not in the last read")
        return 0
    parent = b.get("parent")
    ptitle = (beads.get(parent) or {}).get("title") if parent else None
    pats = wb_search.patterns(query)
    print(f"{bead_id}  P{b.get('priority', '?')}  {b.get('status', '?')}")
    print(wb_search.highlight(pats, b.get("title") or ""))
    print()
    print("parent: " + (f"{parent}  {ptitle}" if ptitle else (parent or "—")))
    print("labels: " + (", ".join(map(str, b.get("labels") or [])) or "—"))
    print()
    print(wb_search.highlight(pats, b.get("description") or "") or "(no description)")
    return 0


def main(argv):
    args = argv[1:]
    if len(args) >= 2 and args[0] == "list":
        opts = dict(zip(args[2::2], args[3::2]))
        if len(args) % 2 or set(opts) - {"--snapshot", "--flow"}:
            print(__doc__, file=sys.stderr)
            return 2
        return cmd_list(args[1], opts.get("--snapshot"), opts.get("--flow"))
    if len(args) == 2 and args[0] == "summary":
        return cmd_summary(args[1])
    if len(args) == 3 and args[0] == "claimed":
        return cmd_claimed(args[1], args[2])
    if len(args) in (3, 4) and args[0] == "preview":
        return cmd_preview(*args[1:])
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))

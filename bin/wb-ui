#!/usr/bin/env python3
"""wb-ui — the launcher's screen helpers. fzf runs these as child processes,
so they can't be zsh functions. TMP is the launch's scratch dir, holding
spaces.tsv (wb-spaces output).

  wb-ui render-spaces TMP      screen 1 lines: index, label, summary
  wb-ui fill-counts TMP        every space's summary, read in parallel, into
                               TMP/counts/<index> (ending, dim, with what `wb-groom status`
                               says: grooming missed, grooming failed Sat, groomed Sat [· partial] · review,
                               strategy due); with $FZF_PORT set,
                               tells fzf to reload as each one lands
  wb-ui render-work TMP INDEX [QUERY]
                               screen 2 lines: kind, id, worktree, header, text
                               (sep and msg rows have an empty id, so the
                               preview shows nothing for them); review and strategy
                               rows (wb-groom status) follow ✦ something new; start here
                               (flagged beads, wb-backlog's picks, then the 30-day flow) comes
                               first; reads bd and keeps what it read in
                               TMP/work.<INDEX>.json
  wb-ui filter-work TMP INDEX QUERY
                               the same lines from that copy, narrowed to beads
                               with any QUERY word (lib/wb_search.py) in short
                               id, title or description: a count, then beads with every
                               word, then beads with some; fzf runs it on each
                               keystroke, so it never calls bd
"""
import json
import os
import re
import shlex
import signal
import subprocess
import sys
import threading
import urllib.request

ME = os.path.realpath(__file__)
BACKLOG = os.path.join(os.path.dirname(ME), "wb-backlog")
GROOM = os.path.join(os.path.dirname(ME), "wb-groom")
STATUS_TIMEOUT = 3  # seconds; the screens never wait longer than this for grooming's news
DAYS = {"Mon": "Monday", "Tue": "Tuesday", "Wed": "Wednesday", "Thu": "Thursday", "Fri": "Friday",
        "Sat": "Saturday", "Sun": "Sunday"}
sys.path.insert(0, os.path.join(os.path.dirname(ME), "..", "lib"))
import wb_search  # noqa: E402  (lives in lib/, found through ME)
FIELDS = ("label", "group", "root", "beads", "worktrees", "session_cmd",
          "space_key", "claude_config", "protocol", "safe")
MESSAGES = {  # wb-backlog list exit code -> screen 2 message
    20: "(bd not installed — something new still works)",
    21: "(no bead store — something new still works)",
    22: "(no readable beads — something new still works)",
    23: "(bd unavailable — ctrl-r to retry)",
    24: "0 open (ctrl-r to re-check)",
}


def spaces(tmp):
    with open(os.path.join(tmp, "spaces.tsv")) as f:
        return [dict(zip(FIELDS, l.rstrip("\n").split("\t"))) for l in f if l.strip()]


def render_spaces(tmp):
    rows = spaces(tmp)
    names = [s["label"] if s["group"] == "-" else f"{s['group']} › {s['label']}" for s in rows]
    width = max(map(len, names), default=0)
    for i, (s, name) in enumerate(zip(rows, names), 1):
        summary = ""
        if s["beads"] != "false":
            try:
                with open(os.path.join(tmp, "counts", str(i))) as f:
                    summary = f.read().strip()
            except FileNotFoundError:
                summary = "…"
        print(f"{i}\t{name.ljust(width)}  \t{summary}")
    print("tabs\t✦ open tabs\t")
    print("q\t[q] just give me a shell\t")


def ritual_status(label):
    """wb-groom status's lines for the space, as field lists: missed, failed, review (run dir,
    weekday) and strategy. Any failure or a slow answer is "nothing to add": it must never fail a screen."""
    try:
        # its own process group: a hung child's children would keep the pipe open past the kill
        p = subprocess.Popen([GROOM, "status", label], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                             text=True, start_new_session=True)
    except OSError:
        return []
    try:
        out, _ = p.communicate(timeout=STATUS_TIMEOUT)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except OSError:
            pass
        return []
    if p.returncode != 0:
        return []
    return [l.split("\t") for l in out.splitlines() if l.strip()]


MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")  # not strftime: locale


def short_date(iso):
    """2026-10-24 as Oct 24; anything else as it came."""
    try:
        y, m, d = (int(x) for x in iso.split("-"))
        return f"{MONTHS[m - 1]} {d}" if 1 <= m <= 12 else iso
    except (ValueError, IndexError):
        return iso


def groomed_note(label):
    """The dim ` · grooming missed Oct 24, see launchd.log · grooming failed Sat, see summary ·
    groomed Sat · review · strategy due`
    that ends a space's summary, or ''."""
    parts = []
    for f in ritual_status(label):
        if f[0] == "missed" and len(f) >= 2:
            parts.append(f"grooming missed {short_date(f[1])}, see launchd.log")
        elif f[0] == "failed" and len(f) >= 3:
            why = "Claude login expired, log in again" if f[3:4] == ["login"] else ""
            parts.append(f"grooming failed {f[2]}: {why}" if why else f"grooming failed {f[2]}, see summary")
        elif f[0] == "review" and len(f) >= 3:
            parts.append(f"groomed {f[2]}{' · partial' if 'partial' in f[3:] else ''} · review")
        elif f[0] == "strategy":
            parts.append("strategy due")
    return f"\033[2m · {' · '.join(parts)}\033[0m" if parts else ""


def ritual_rows(label):
    """Screen 2's rows for the review and strategy sessions, when grooming has news."""
    plan = os.path.join(os.environ.get("WB_PLANS_DIR") or os.path.expanduser("~/.config/workbench/plans"), label)
    rows = []
    for f in ritual_status(label):
        if f[0] == "review" and len(f) >= 3:
            partial = " (partial: not the whole backlog)" if "partial" in f[3:] else ""
            rows.append(f"review\t-\t{f[1]}\t\t✦ review {DAYS.get(f[2], f[2])}'s grooming{partial}")
        elif f[0] == "strategy":
            rows.append(f"strategy\t-\t{plan}\t\t✦ strategy session")
    return sorted(rows, key=lambda r: not r.startswith("review"))


def fill_counts(tmp):
    counts = os.path.join(tmp, "counts")
    os.makedirs(counts, exist_ok=True)
    port = os.environ.get("FZF_PORT")
    reload = f"reload({shlex.quote(sys.executable)} {shlex.quote(ME)} render-spaces {shlex.quote(tmp)})"

    def one(i, s):
        p = subprocess.run([BACKLOG, "summary", s["root"]], capture_output=True, text=True)
        path = os.path.join(counts, str(i))
        with open(path + ".part", "w") as f:
            f.write((p.stdout.strip() or "(bd unavailable)") + groomed_note(s["label"]))
        os.replace(path + ".part", path)
        if port:
            try:
                urllib.request.urlopen(urllib.request.Request(
                    f"http://127.0.0.1:{port}", data=reload.encode(), method="POST"), timeout=1).close()
            except OSError:
                pass  # fzf has already closed

    threads = [threading.Thread(target=one, args=(i, s))
               for i, s in enumerate(spaces(tmp), 1) if s["beads"] != "false"]
    for t in threads:
        t.start()
    for t in threads:
        t.join()


def render_work(tmp, index, query=""):
    s = spaces(tmp)[int(index) - 1]
    print("new\t-\t-\t\t✦ something new", flush=True)
    work = {"rows": [], "msg": None, "flow": None, "rituals": ritual_rows(s["label"])}
    print_rituals(work, query)
    if s["beads"] != "false":
        flow = os.path.join(tmp, f"flow.{index}")
        try:
            os.remove(flow)  # a ctrl-r re-read must not show the last read's line
        except FileNotFoundError:
            pass
        p = subprocess.run([BACKLOG, "list", s["root"], "--snapshot", os.path.join(tmp, "snapshot.json"),
                            "--flow", flow], capture_output=True, text=True)
        if p.returncode != 0:
            work["msg"] = MESSAGES.get(p.returncode, MESSAGES[23])
        else:
            work["rows"] = [l.split("\t") for l in p.stdout.splitlines() if l]
            try:
                with open(flow) as f:
                    work["flow"] = f.read().strip() or None
            except OSError:
                pass  # no line: nothing to say, or the closed beads couldn't be read
    path = os.path.join(tmp, f"work.{index}.json")
    with open(path + ".part", "w") as f:  # write-then-rename: a keystroke's filter-work may be reading it
        json.dump(work, f, ensure_ascii=False)
    os.replace(path + ".part", path)
    print_work(tmp, work, query)


def filter_work(tmp, index, query):
    print("new\t-\t-\t\t✦ something new", flush=True)
    try:
        with open(os.path.join(tmp, f"work.{index}.json")) as f:
            work = json.load(f)
    except (OSError, ValueError):
        work = {"rows": [], "msg": MESSAGES[23]}
    print_rituals(work, query)
    print_work(tmp, work, query)


def print_rituals(work, query):
    if not query.strip():  # a search is for beads; these rows are not
        for r in work.get("rituals", []):
            print(r)


def print_work(tmp, work, query):
    if work["msg"]:
        print(f"msg\t\t-\t{work['msg']}\t")
        return
    rows = work["rows"]
    # a space with no epics gets no empty column; ids pad to the longest
    # ("abcd.12", a sub-epic's child), so the columns after them line up
    layout = {"epics": any(r[8] != "-" for r in rows), "idw": max([6] + [len(r[1]) for r in rows])}
    pats = wb_search.patterns(query)
    if pats:
        print_matches(tmp, rows, pats, layout)
        return
    picks = sorted((r for r in rows if r[10] != "-"), key=lambda r: int(r[10].split(" ", 1)[0]))
    # flagged beads lead and are never capped away: the rest are counted, not hidden
    # (every bead is still in its own section below)
    flagged = sorted((r for r in rows if r[11] != "-"), key=lambda r: int(r[11].split(" ", 1)[0]))
    if flagged or picks:
        print("sep\t\t-\t── start here ──\t")
        for r in flagged[:ATTENTION_SHOWN]:
            print_row(r, (), layout, "! " + r[11].split(" ", 1)[1])
        if len(flagged) > ATTENTION_SHOWN:
            print(f"msg\t\t-\t+{len(flagged) - ATTENTION_SHOWN} more need attention\t")
        for r in picks:
            print_row(r, (), layout, r[10].split(" ", 1)[1])
        if work.get("flow"):
            print(f"msg\t\t-\t{work['flow']}\t")
    waves = any(r[4] != "-" for r in rows)
    current = None
    for r in rows:
        if (waves or picks or flagged) and r[4] != current:
            current = r[4]
            print(f"sep\t\t-\t── {SECTIONS.get(current, current)} ──\t")
        print_row(r, (), layout)


def print_matches(tmp, rows, pats, layout):
    """A count, then beads matching every word, then beads matching some,
    with the matched words highlighted. Within each, beads with more words in
    the title come first (a highlighted row shows why it's there), then
    backlog order."""
    try:
        with open(os.path.join(tmp, "snapshot.json")) as f:
            beads = json.load(f)
    except (OSError, ValueError):
        beads = {}
    every, some = [], []
    for r in rows:
        # the short id, not the full one: every id shares the space's prefix ("acme-")
        flag = f"attention {r[11].split(' ', 1)[1]}" if r[11] != "-" else ""  # the spec's "in the search (attention)"
        n = wb_search.hits(pats, f"{r[1]}\n{r[5]}\n{r[8]}\n{(beads.get(r[0]) or {}).get('description') or ''}\n{flag}")
        if n:
            (every if n == len(pats) else some).append(r)
    if not every and not some:
        print("msg\t\t-\t(no beads match)\t")
    elif len(pats) == 1:
        print(f"msg\t\t-\t{len(every)} match\t")
    else:
        print(f"msg\t\t-\t{len(every)} match all words · {len(some)} match some\t")
    for label, group in (("all words", every), ("some words", some)):
        group.sort(key=lambda r: -wb_search.hits(pats, f"{r[1]}\n{r[5]}"))  # stable: ties keep backlog order
        if group and len(pats) > 1:
            print(f"sep\t\t-\t── {label} ──\t")
        for r in group:
            print_row(r, pats, layout)


ATTENTION_SHOWN = 5
EPIC_W, DIM = 20, "\033[2m"
SECTIONS = {"-": "everything else", "ICEBOX": "icebox"}  # dividers; NOW and NEXT as they are


def epic_cell(ptitle, pats):
    """The parent's title, cut to a fixed width so the bead titles after it
    line up; dim, since the bead's own title is what the row is about."""
    t = "" if ptitle == "-" else re.sub(r"^epic:\s*", "", ptitle, flags=re.I)
    if len(t) > EPIC_W:
        t = t[:EPIC_W - 1] + "…"
    pad = " " * (EPIC_W - len(t))
    if not t:
        return pad
    # a highlight's reset would end the dim too, so dim again after each one
    return DIM + wb_search.highlight(pats, t).replace(wb_search.END, wb_search.END + DIM) + pad + wb_search.END


def print_row(r, pats, layout, why=None):
    bid, short, mark, prio, _sect, title, _parent, wt, ptitle, idle, _pick, _attn, until = r
    kind = "claimed" if mark == "◐" else "open"
    pad = " " * (layout["idw"] - len(short))  # padded outside the highlight, so columns stay aligned
    epic = f"{epic_cell(ptitle, pats)}  " if layout["epics"] else ""
    print(f"{kind}\t{bid}\t{wt}\t\t{mark} {wb_search.highlight(pats, short)}{pad} {prio}  "
          f"{epic}{wb_search.highlight(pats, title)}"
          + ("" if idle == "-" else f"  {DIM}idle {idle}d{wb_search.END}")
          + ("" if until == "-" else f"  {DIM}deferred until {until}{wb_search.END}")
          + (f"  {DIM}{why}{wb_search.END}" if why else ""))


def main(argv):
    cmd, args = (argv[1], argv[2:]) if len(argv) > 1 else ("", [])
    if cmd == "render-spaces" and len(args) == 1:
        render_spaces(*args)
    elif cmd == "fill-counts" and len(args) == 1:
        fill_counts(*args)
    elif cmd == "render-work" and len(args) in (2, 3):
        render_work(*args)
    elif cmd == "filter-work" and len(args) == 3:
        filter_work(*args)
    else:
        print(__doc__, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

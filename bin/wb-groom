#!/usr/bin/env python3
"""wb-groom — weekly grooming: a read-only judge (Claude) writes decisions.json, then apply.

  wb-groom run SPACE | --all
      Grooms SPACE (a label from wb-spaces), or with --all every space whose plan directory
      ($WB_PLANS_DIR/<label>, default ~/.config/workbench/plans) exists, going on past a failed
      space. Per space, holding $WB_GROOM_DIR/<label>/.lock (default ~/.local/state/workbench/groom):
      makes the run dir <label>/YYYYMMDD-HHMM (-02, -03 … within one minute), writes inputs.json
      (plan file hashes, plan state, the judge's argv), runs the judge (claude -p, read-only, in the
      space root, with the space's claude_config or none; see judge_argv in lib/wb_groom.py) for at
      most WB_GROOM_TIMEOUT seconds (default 1200), then applies (below) unless the judge failed,
      timed out or left no decisions.json. The judge reads the backlog from judge/backlog.tsv
      (every live bead on a line, ending `# end <marker> <N> beads`; marker and N also go in
      inputs.json) and must echo both as decisions.backlog. When it doesn't, or a sprint section it
      sets leaves out a bead now in that wave, the run is partial: the reasons go in <run dir>/partial
      and every op becomes a proposal ("backlog not fully read"). Either way summary.md is the
      judge's summary with what workbench did: a lead line when nothing was applied, the run is
      partial ("partial grooming: …") or the plan is missing or stale ("strategy session needed"), what apply printed, "N earlier runs not yet reviewed" (runs with
      no `reviewed` file) and whether the store syncs to a shared remote. The judge can write
      only in <run dir>/judge/; wb-groom takes its summary.md, and its decisions.json when it
      finished, from there. Also in the run dir: judge.json and judge.err (the judge's output)
      and apply.log. WB_CLAUDE names claude.

  wb-groom ops RUN_DIR SPACE_ROOT [--plan PLAN_DIR]
      What RUN_DIR/decisions.json comes to against the live beads in SPACE_ROOT, as TSV:
        id, kind, value, why      an op workbench may apply by itself
        proposal, id, kind, to, why, reason   a change left for review (numbered by line order)
        dropped, "<id>: <reason>" a decision refused
      PLAN_DIR is the space's plan directory; without one the plan is missing and every op
      becomes a proposal. Exits 3 (decisions.json unreadable) or 4 (bd could not be read)
      with nothing on stdout. WB_TODAY=YYYY-MM-DD fixes "today" for tests.

  wb-groom apply RUN_DIR SPACE_ROOT [--plan PLAN_DIR] [--proposal N]
      Applies the ops (above) to SPACE_ROOT's beads, with bd --sandbox, one update per bead.
      Writes in RUN_DIR: proposals.json (the proposals, numbered by position from 1), then
      before.jsonl (each touched bead's labels, priority, status, notes, updated_at, fsynced
      before the first bd write), then applied.jsonl (one line per bead: the ops, the same
      fields read back after the writes, "proposal" N or null, "error" on a failure).
      --proposal N applies only proposal N of proposals.json (its before-state is appended
      to before.jsonl, its result to applied.jsonl): icebox, wave, unwave, priority, close,
      undefer, attention, unattention. merge, dep and date are applied by hand in review.
      A full apply of a run that has a before.jsonl is refused, as is a proposal applied twice.
  wb-groom undo RUN_DIR [ID]
      Restores labels, priority, status and notes from before.jsonl (the first record of a
      bead wins) and appends no note; each is recorded in undone.jsonl and skipped on a second
      undo. A bead whose state no longer matches its applied.jsonl line is refused:
      "ID changed since the run; not undone".

  wb-groom status LABEL
      What the launcher offers for the space LABEL, as TSV lines (none when there is nothing):
        missed, <YYYY-MM-DD>                            the Saturday run left no run dir: the
                                                        space's newest run is older than the last
                                                        Saturday before today, the launch agent is
                                                        installed (WB_LAUNCH_AGENTS_DIR, default
                                                        ~/Library/LaunchAgents) and the space has a
                                                        plan dir and earlier runs. launchd.log in
                                                        the groom dir says why.
        failed, <run dir>, <weekday>[, login]           the newest run stopped with nothing applied
                                                        (summary.md but no decisions.json); login
                                                        when judge.json's error is an expired login
        review, <run dir>, <weekday>[, "<k> waiting"][, partial]
                                                        the newest run without a `reviewed` file
                                                        that did not fail (k more are waiting, when
                                                        any are; partial when that run was)
        strategy, due                                   the plan is due, stale or missing, and the
                                                        space has runs (a space with neither plan
                                                        nor runs shows nothing)
      Always exits 0: the launcher calls it on every screen.
  wb-groom reviewed RUN_DIR
      Marks the run reviewed (a `reviewed` file holding the date; the judge cannot write it).
  wb-groom strategy LABEL
      Makes the plan directory from lib/plan-templates/ when it is absent, and prints its path.
      A fresh template carries `date: YYYY-MM-DD`, so the plan still counts as missing (fail
      closed) until the strategy session sets a real date. An existing directory is left alone.

Exit codes: 0 ok; 2 usage (or an unknown space, or no spaces, or no such run directory); 3 decisions.json unreadable; 4 bd
could not be read; 5 a bd write failed (the run stops; what was applied is in applied.jsonl); 6 the
run dir is not writable (nothing applied); 7 apply refused (already applied, no such proposal,
applied by hand); 8 undo refused or skipped a named bead; 9 a grooming run is in progress for the
space (another holds its lock); 10 the judge failed, timed out or left no decisions.json (nothing
applied). run --all exits 1 when any space did not exit 0.
"""
import contextlib
import datetime
import fcntl
import hashlib
import io
import json
import os
import re
import secrets
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import wb_groom  # noqa: E402  (lives in lib/; realpath, since install.sh links bin/ elsewhere)
import wb_touched  # noqa: E402

BD = os.environ.get("WB_BD", "bd")
HERE = os.path.dirname(os.path.realpath(__file__))
EXIT_DECISIONS, EXIT_BD, EXIT_WRITE, EXIT_RUN_DIR, EXIT_REFUSED, EXIT_UNDO = 3, 4, 5, 6, 7, 8
EXIT_LOCKED, EXIT_JUDGE = 9, 10  # 5 is a failed bd write, so a held lock gets its own code
PLAN_FILES = ("goals.md", "protected.md", "calendar.md", "sources.md")


def tsv(*fields):
    return "\t".join(" ".join(str(f).split()) for f in fields)


def load(run_dir, root, plan_dir):
    """(decisions, beads, plan, today), or an exit code after saying what is wrong."""
    try:
        with open(os.path.join(run_dir, "decisions.json"), encoding="utf-8") as f:
            decisions = json.load(f)
        if not isinstance(decisions, dict):
            raise ValueError("not an object")
    except (OSError, ValueError):  # JSONDecodeError and UnicodeDecodeError are ValueErrors
        print("decisions.json unreadable", file=sys.stderr)
        return EXIT_DECISIONS
    try:
        beads = wb_groom.read_beads(root, BD)
    except wb_groom.BdReadError as e:
        print(f"wb-groom: {e}", file=sys.stderr)
        return EXIT_BD
    return decisions, beads, wb_groom.read_plan(plan_dir) if plan_dir else None, today()


def today():
    return datetime.date.fromisoformat(os.environ["WB_TODAY"]) if os.environ.get("WB_TODAY") else datetime.date.today()


def cmd_ops(run_dir, root, plan_dir):
    got = load(run_dir, root, plan_dir)
    if isinstance(got, int):
        return got
    decisions, beads, plan, day = got
    ops, proposals, dropped = wb_groom.plan_ops(decisions, beads, plan, day)
    for o in ops:
        print(tsv(o.id, o.kind, o.value, o.why))
    for p in proposals:
        print(tsv("proposal", p["id"], p["kind"], p["to"], p["why"], p["reason"]))
    for d in dropped:
        print(tsv("dropped", d))
    return 0


def write_proposals(run_dir, proposals):
    path = os.path.join(run_dir, "proposals.json")
    with open(path, "w", encoding="utf-8") as f:
        json.dump(proposals, f, indent=1)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())


def run_apply(run_dir, root, ops, day, proposal=None):
    try:
        applied, failed, error, recorded = wb_groom.apply_ops(run_dir, root, ops, BD, day.isoformat(), proposal)
    except wb_groom.BdReadError as e:
        print(f"wb-groom: nothing applied: {e}", file=sys.stderr)
        return EXIT_BD
    except OSError as e:
        print(f"wb-groom: nothing applied: cannot write the run record: {e}", file=sys.stderr)
        return EXIT_RUN_DIR
    if failed:
        after = f"recorded in applied.jsonl; undo with: wb-groom undo {run_dir}" if recorded else \
            f"{failed} is NOT in applied.jsonl, so undo cannot see it"
        print(f"wb-groom: {failed} failed ({error}); stopped after {len(applied)} bead(s) ({after})", file=sys.stderr)
        return EXIT_WRITE
    print(f"applied {len(applied)} bead(s)")
    return 0


def cmd_apply(run_dir, root, plan_dir, number, partial=False):
    def refuse(msg):
        print(f"wb-groom: {msg}", file=sys.stderr)
        return EXIT_REFUSED

    if number is None and wb_groom.read_jsonl(os.path.join(run_dir, "before.jsonl")):
        return refuse(f"{run_dir} already applied; start a new run")
    if number is not None:
        try:
            with open(os.path.join(run_dir, "proposals.json"), encoding="utf-8") as f:
                proposals = json.load(f)
        except (OSError, ValueError):
            return refuse("no proposals.json in the run; apply the run first")
        if not (isinstance(proposals, list) and 1 <= number <= len(proposals)):
            return refuse(f"no proposal {number} in this run")
        p = proposals[number - 1]
        if p["kind"] in wb_groom.BY_HAND:
            return refuse(f"proposal {number} ({p['kind']}) is applied by hand in review")
        if any(r.get("proposal") == number for r in wb_groom.read_jsonl(os.path.join(run_dir, "applied.jsonl"))):
            return refuse(f"proposal {number} already applied")
        # the label an op names; wave, unwave and priority carry theirs in `to`
        value = {"icebox": wb_groom.ICEBOX, "attention": wb_groom.ATTENTION,
                 "unattention": wb_groom.ATTENTION}.get(p["kind"], p["to"])
        if value == "" and p["kind"] in ("wave", "unwave", "priority"):
            return refuse(f"proposal {number} ({p['kind']}) has no value to apply")
        return run_apply(run_dir, root, [wb_groom.Op(p["id"], p["kind"], value, p["why"])], today(), number)
    got = load(run_dir, root, plan_dir)
    if isinstance(got, int):
        return got
    decisions, beads, plan, day = got
    ops, proposals, dropped = wb_groom.plan_ops(decisions, beads, plan, day, partial)
    try:
        write_proposals(run_dir, proposals)
    except OSError as e:
        print(f"wb-groom: nothing applied: cannot write the run record: {e}", file=sys.stderr)
        return EXIT_RUN_DIR
    for d in dropped:
        print(f"dropped: {d}")
    print(f"{len(proposals)} proposal(s) left for review")
    return run_apply(run_dir, root, ops, day)


def cmd_undo(run_dir, only):
    # The bead store is wherever the run was applied; bd finds it from the run's own record.
    try:
        root = wb_groom.read_jsonl(os.path.join(run_dir, "applied.jsonl"))[0].get("root")
    except IndexError:
        root = None
    msgs, refused = wb_groom.undo_run(run_dir, root, BD, only)
    for m in msgs:
        print(m)
    return EXIT_UNDO if refused else 0


# --- run: the judge, then apply ---

def read_spaces():
    """wb-spaces' rows as dicts (label, root, claude_config, protocol; None for '-'; judge_env, a
    dict), or None."""
    p = subprocess.run([os.path.join(HERE, "wb-spaces")], text=True, capture_output=True)
    e = subprocess.run([os.path.join(HERE, "wb-spaces"), "--judge-env"], text=True, capture_output=True)
    if p.returncode != 0 or e.returncode != 0:
        print((p.stderr or e.stderr).strip(), file=sys.stderr)
        return None
    try:
        extra = json.loads(e.stdout)
    except ValueError:
        print("workbench: wb-spaces --judge-env printed no JSON", file=sys.stderr)
        return None
    rows = []
    for line in p.stdout.splitlines():
        f = [None if v == "-" else v for v in line.split("\t")]
        if len(f) >= 13:  # columns are only ever appended (after_end is the 14th)
            rows.append({"label": f[0], "root": f[2], "claude_config": f[7], "protocol": f[8],
                         "judge_env": extra.get(f[0], {})})
    return rows


def plans_dir():
    return os.environ.get("WB_PLANS_DIR") or os.path.expanduser("~/.config/workbench/plans")


def groom_dir():
    return os.environ.get("WB_GROOM_DIR") or os.path.expanduser("~/.local/state/workbench/groom")


def new_run_dir(base):
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M")
    for n in range(1, 100):
        path = os.path.join(base, stamp if n == 1 else f"{stamp}-{n:02d}")  # -02 sorts after the first
        try:
            os.mkdir(path)
            return path
        except FileExistsError:
            continue
    raise OSError(f"too many runs in {base} this minute")


def sha256(path):
    try:
        with open(path, "rb") as f:
            return hashlib.sha256(f.read()).hexdigest()
    except OSError:
        return None


def write_json(path, data):
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=1, sort_keys=True)
        f.write("\n")


def earlier_unreviewed(base, run_dir):
    return sum(1 for d in os.listdir(base) if d[:1].isdigit() and os.path.join(base, d) != run_dir
               and os.path.isdir(os.path.join(base, d)) and not os.path.exists(os.path.join(base, d, "reviewed"))
               and not run_failed(os.path.join(base, d)))


def run_failed(run_dir):
    """True when the run stopped with nothing applied: its summary is written but the judge left
    no decisions.json, so there is nothing to review. Read from the files, not a record, so runs
    from before this check count too; one still going has no summary.md yet."""
    return (os.path.isfile(os.path.join(run_dir, "summary.md"))
            and not os.path.exists(os.path.join(run_dir, "decisions.json")))


LOGIN_RE = re.compile(r"oauth|authenticat|log ?in\b|/login", re.I)


def judge_error(run_dir):
    """The first line of the error `claude -p` reported in judge.json (is_error), or None. A
    judge cut off mid-write leaves a file that isn't JSON: that's None too."""
    try:
        with open(os.path.join(run_dir, "judge.json"), encoding="utf-8") as f:
            out = json.load(f)
    except (OSError, ValueError):
        return None
    if not isinstance(out, dict) or out.get("is_error") is not True or not isinstance(out.get("result"), str):
        return None
    lines = out["result"].strip().splitlines()
    return lines[0][:200] if lines else None


def login_expired(run_dir):
    err = judge_error(run_dir)
    return bool(err and LOGIN_RE.search(err))


def shared_remote(root):
    """True when one of ROOT's git remotes has refs/dolt/data, False when none has, None when
    that can't be told (a remote that failed or ran out of the five seconds, git missing). Not a
    git repo, or no remotes, is False."""
    env = {**os.environ, "GIT_TERMINAL_PROMPT": "0"}
    git = ["git", "-C", root]

    def run(args, timeout):
        return subprocess.run(git + args, text=True, capture_output=True, stdin=subprocess.DEVNULL,
                              env=env, timeout=timeout)

    deadline = datetime.datetime.now() + datetime.timedelta(seconds=5)
    try:
        if run(["rev-parse", "--git-dir"], 5).returncode != 0:
            return False
        # Never prompt for a passphrase; but a repo's own core.sshCommand wins, as it would for git.
        if run(["config", "core.sshCommand"], 5).returncode != 0:
            env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes")
        unsure = False
        for r in run(["remote"], 5).stdout.split():
            left = (deadline - datetime.datetime.now()).total_seconds()
            if left <= 0:
                return None
            p = run(["ls-remote", r, "refs/dolt/data"], left)
            if p.returncode == 0 and p.stdout.strip():
                return True
            unsure = unsure or p.returncode != 0
        return None if unsure else False
    except (OSError, subprocess.TimeoutExpired):
        return None


def fill_prompt(fields):
    with open(os.path.join(HERE, "..", "prompts", "groom.txt"), encoding="utf-8") as f:
        text = f.read()
    for k, v in fields.items():
        text = text.replace("{" + k + "}", str(v))  # not format(): the JSON example has braces
    return text


# What the judge's environment may hold: the basics a process needs, the variables Claude Code
# authenticates with, and the test fake's knobs. Nothing else from the caller (GITHUB_TOKEN, cloud
# keys …) reaches a process that reads untrusted bead text. Only the space's account is used:
# never a CLAUDE_CONFIG_DIR inherited from whoever started wb-groom, nor a Claude session's markers.
# A space whose account needs more (a proxy, Bedrock's settings) names it, with its value, in its
# judge_env in spaces.toml: values, not names to pass through, since the Saturday launchd run has
# no shell environment to take them from, and the profile's settings.json env is not read either
# (judge_argv drops every settings source).
JUDGE_ENV = ("PATH", "HOME", "USER", "LOGNAME", "SHELL", "LANG", "TMPDIR",
             "ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL", "CLAUDE_CODE_OAUTH_TOKEN")


def judge_env(claude_config, extra=None):
    env = {k: v for k, v in os.environ.items()
           if k in JUDGE_ENV or k.startswith("LC_") or k.startswith("FAKE_CLAUDE_")}
    env.update(extra or {})  # wb-spaces refuses PATH and CLAUDE_CONFIG_DIR here
    if claude_config:
        env["CLAUDE_CONFIG_DIR"] = claude_config
    return env


def finish_summary(run_dir, base, root, lead, applied):
    """Rewrite summary.md as LEAD lines, the judge's summary, APPLIED (what apply printed) and
    the lines wb-groom owns."""
    path = os.path.join(run_dir, "summary.md")
    judge = wb_groom._read(path)
    parts = []
    if lead:
        parts.append("\n".join(lead) + "\n")
    parts.append(judge.rstrip() + "\n" if judge and judge.strip() else "(the judge wrote no summary.md)\n")
    if applied:
        parts.append("## What workbench did\n" + "\n".join(applied) + "\n")
    tail = []
    n = earlier_unreviewed(base, run_dir)
    if n:
        tail.append(f"{n} earlier runs not yet reviewed")
    remote = shared_remote(root) if root else False
    if remote:
        tail.append("This store syncs to a shared remote: changes go out with your next sync")
    elif remote is None:
        tail.append("Could not check whether this store syncs to a shared remote")
    if tail:
        parts.append("\n".join(tail) + "\n")
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write("\n".join(parts))
    os.replace(path + ".tmp", path)


def groom_space(space):
    """One space's run, under its lock. Returns an exit code."""
    label = space["label"]
    if "/" in label or label.startswith("."):
        # the label names the plan and run dirs; one like ../x would leave them
        print(f"wb-groom: {label}: a space label used as a folder name can't hold / or start with .", file=sys.stderr)
        return 2
    base = os.path.join(groom_dir(), label)
    try:
        os.makedirs(base, exist_ok=True)
        lock = open(os.path.join(base, ".lock"), "a")
    except OSError as e:
        print(f"wb-groom: {label}: cannot use {base}: {e}", file=sys.stderr)
        return EXIT_RUN_DIR
    with lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)  # the kernel drops it if we die
        except BlockingIOError:
            print(f"wb-groom: {label}: a grooming run is in progress", file=sys.stderr)
            return EXIT_LOCKED
        try:
            run_dir = new_run_dir(base)
        except OSError as e:
            print(f"wb-groom: {label}: cannot make a run dir: {e}", file=sys.stderr)
            return EXIT_RUN_DIR
        print(f"{label}: {run_dir}")
        return groom_in(space, base, os.path.realpath(run_dir))


def lift(judge_dir, run_dir, name):
    """Move the judge's NAME up into the run dir, if it wrote one as a plain file. The judge can
    write only in judge_dir, so it can't touch the run record (inputs.json, before.jsonl,
    reviewed …); these two files are all wb-groom takes from it."""
    src = os.path.join(judge_dir, name)
    if os.path.isfile(src) and not os.path.islink(src):
        os.replace(src, os.path.join(run_dir, name))


PARTIAL = "partial"  # in a run dir: why the judge's run did not cover the backlog


def backlog_gaps(run_dir, beads, backlog):
    """wb_groom.backlog_gaps for the run's decisions.json; an unreadable one has none (apply
    refuses it with its own exit)."""
    try:
        with open(os.path.join(run_dir, "decisions.json"), encoding="utf-8") as f:
            decisions = json.load(f)
    except (OSError, ValueError):
        return []
    return wb_groom.backlog_gaps(decisions, beads, backlog) if isinstance(decisions, dict) else []


def groom_in(space, base, run_dir):
    label, root = space["label"], space["root"]
    judge_dir = os.path.join(run_dir, "judge")
    plan_dir = os.path.join(plans_dir(), label)
    plan = wb_groom.read_plan(plan_dir)
    day = today()
    state = wb_groom.plan_state(plan, day)
    plan_dir = os.path.realpath(plan_dir) if plan else None
    lead = [f"strategy session needed (plan {state}): nothing was applied unattended; every change "
            "waits for review"] if state in ("missing", "stale") else []

    def stop(code, why, err=None):
        print(f"wb-groom: {label}: {err or why}", file=sys.stderr)
        try:
            finish_summary(run_dir, base, root, [why] + lead, [])
        except OSError as e:
            print(f"wb-groom: {label}: cannot write summary.md: {e}", file=sys.stderr)
            return code if code != 0 else EXIT_RUN_DIR
        return code

    # A store that can't be read now would fail apply after a long judge run: stop first.
    try:
        beads = wb_groom.read_beads(root, BD)
    except wb_groom.BdReadError as e:
        return stop(EXIT_BD, f"bd could not be read ({e}); the judge did not run; nothing applied")
    protocol = space["protocol"]
    judge_bd = os.path.join(run_dir, wb_groom.JUDGE_BD)
    fields = {"space": label, "root": root, "today": day.isoformat(), "run_dir": judge_dir, "bd": judge_bd,
              "plan_dir": plan_dir or f"{os.path.join(plans_dir(), label)} (missing)", "plan_state": state,
              "protocol": os.path.join(root, protocol) if protocol else "none named",
              "now_size": plan.now_size if plan else wb_groom.DEFAULT_SIZES["now"],
              "next_size": plan.next_size if plan else wb_groom.DEFAULT_SIZES["next"],
              "claims": wb_groom.claims_line(beads, wb_touched.grooming_stamps(root, groom_dir()), day)}
    backlog = {"end": secrets.token_hex(8)}  # per run: an old run's marker proves nothing
    fields["backlog"] = os.path.join(judge_dir, wb_groom.BACKLOG)
    try:
        os.mkdir(judge_dir)
        # the same snapshot apply checks against; its count and marker go in inputs.json, which
        # the judge can't write, so wb-groom can tell whether the judge read to the end
        backlog["beads"] = wb_groom.write_backlog(fields["backlog"], beads, backlog["end"])
        wb_groom.write_judge_bd(run_dir, root, BD)
        argv = wb_groom.judge_argv(os.environ.get("WB_CLAUDE", "claude"), judge_bd, root, plan_dir, judge_dir,
                                   fill_prompt(fields))
        write_json(os.path.join(run_dir, "inputs.json"), {
            "space": label, "root": root, "plan_dir": plan_dir, "plan_state": state,
            "goals_date": plan.goals_date.isoformat() if plan and plan.goals_date else None,
            "plan_files": {f: sha256(os.path.join(plan_dir, f)) if plan_dir else None for f in PLAN_FILES},
            "claude_config": space["claude_config"],
            "judge_env": sorted(space["judge_env"]),  # names only: a value may be a credential
            "started_at": datetime.datetime.now().isoformat(timespec="seconds"),
            "backlog": backlog, "judge_argv": argv})
    except OSError as e:
        return stop(EXIT_RUN_DIR, "the run could not be set up; nothing applied", f"{e}")
    try:
        timeout = float(os.environ.get("WB_GROOM_TIMEOUT") or 1200)
    except ValueError:
        return stop(2, "WB_GROOM_TIMEOUT is not a number of seconds; the judge did not run")
    try:
        rc, timed_out = wb_groom.run_judge(argv, root, judge_env(space["claude_config"], space["judge_env"]), timeout,
                                           os.path.join(run_dir, "judge.json"), os.path.join(run_dir, "judge.err"))
    except OSError as e:
        return stop(EXIT_JUDGE, f"the judge could not start ({e}); nothing applied")
    try:
        lift(judge_dir, run_dir, "summary.md")  # its words are kept whatever happened
    except OSError as e:
        return stop(EXIT_RUN_DIR, f"cannot take the judge's summary.md ({e}); nothing applied")
    if timed_out:
        return stop(EXIT_JUDGE, f"the judge timed out after {timeout:g} s; nothing applied; see judge.json and judge.err in the run dir")
    if rc != 0:
        said = judge_error(run_dir)
        if said and login_expired(run_dir):
            # the fix is outside wb-groom: only a fresh login on that account lets the next run in
            lead = [f"the judge's Claude login has expired: log in again on the space's Claude account "
                    f"(CLAUDE_CONFIG_DIR={space['claude_config'] or 'the default'}), then wb-groom run {label}"] + lead
        return stop(EXIT_JUDGE, f"the judge failed (exit {rc}){': ' + said if said else ''}; nothing applied; "
                    "see judge.json and judge.err in the run dir")
    try:
        lift(judge_dir, run_dir, "decisions.json")  # only from a judge that finished
    except OSError as e:
        return stop(EXIT_RUN_DIR, f"cannot take the judge's decisions.json ({e}); nothing applied")
    if not os.path.isfile(os.path.join(run_dir, "decisions.json")):
        return stop(EXIT_JUDGE, "the judge left no decisions.json; nothing applied; see judge.json and judge.err in the run dir")
    gaps = backlog_gaps(run_dir, beads, backlog)
    if gaps:
        try:
            with open(os.path.join(run_dir, PARTIAL), "w", encoding="utf-8") as f:
                f.write("\n".join(gaps) + "\n")
        except OSError as e:
            return stop(EXIT_RUN_DIR, f"cannot record a partial run ({e}); nothing applied")
        lead = ["partial grooming: nothing was applied unattended; every change waits for review: "
                + "; ".join(gaps)] + lead
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        code = cmd_apply(run_dir, root, plan_dir, None, bool(gaps))
    said = out.getvalue().splitlines() + err.getvalue().splitlines()
    with open(os.path.join(run_dir, "apply.log"), "w", encoding="utf-8") as f:
        f.write("\n".join(said + [f"exit {code}"]) + "\n")
    sys.stdout.write(out.getvalue())
    sys.stderr.write(err.getvalue())
    if code != 0:
        lead = [f"apply stopped (exit {code}); see apply.log"] + lead
    try:
        finish_summary(run_dir, base, root, lead, said)
    except OSError as e:
        print(f"wb-groom: {label}: cannot write summary.md: {e}", file=sys.stderr)
        return code if code != 0 else EXIT_RUN_DIR
    return code


def cmd_run(target):
    spaces = read_spaces()
    if spaces is None:
        return 2
    if target != "--all":
        space = next((s for s in spaces if s["label"] == target), None)
        if space is None:
            print(f"wb-groom: no space named {target}", file=sys.stderr)
            return 2
        return groom_space(space)
    failed = []
    for space in spaces:
        if os.path.isdir(os.path.join(plans_dir(), space["label"])):
            try:
                code = groom_space(space)
            except Exception as e:  # one space's bug must not cost the others their run
                print(f"wb-groom: {space['label']}: crashed: {type(e).__name__}: {e}", file=sys.stderr)
                failed.append(f"{space['label']} (crashed)")
                continue
            if code != 0:
                failed.append(f"{space['label']} (exit {code})")
    if failed:
        print(f"wb-groom: failed: {', '.join(failed)}", file=sys.stderr)
    return 1 if failed else 0


# --- status, reviewed, strategy: the launcher's side ---

RUN_ID_RE = re.compile(r"^(\d{8})-\d{4}(-\d{2})?$")
WEEKDAYS = ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")  # not strftime: it follows the locale


def all_runs(label):
    """The space's run dirs, oldest first. Anything else in the groom dir (.lock, stray files,
    other folders) is not a run."""
    base = os.path.join(groom_dir(), label)
    try:
        names = sorted(os.listdir(base))
    except OSError:
        return []
    return [os.path.join(base, n) for n in names if RUN_ID_RE.match(n) and os.path.isdir(os.path.join(base, n))]


def unreviewed(runs):
    return [r for r in runs if not os.path.exists(os.path.join(r, "reviewed"))]


def scheduled():
    """True when install.sh's launch agent is in place (it isn't after --no-schedule)."""
    agents = os.environ.get("WB_LAUNCH_AGENTS_DIR") or os.path.expanduser("~/Library/LaunchAgents")
    return os.path.isfile(os.path.join(agents, "workbench.groom.plist"))


def missed_saturday(label, runs, day):
    """The last Saturday before DAY (never DAY itself: its 06:00 run, or the run at wake, may be
    still to come) when the space's newest run is older than it, else None. Any failure before a
    run dir exists (an unwritable groom dir, the agent never starting wb-groom) leaves only this
    gap, so the gap is what's checked. Only a space run --all grooms (it has a plan dir) that has
    been groomed before, and only with the schedule installed."""
    if not runs or not scheduled() or not os.path.isdir(os.path.join(plans_dir(), label)):
        return None
    sat = day - datetime.timedelta(days=(day.weekday() - 5) % 7 or 7)
    newest = max(RUN_ID_RE.match(os.path.basename(r)).group(1) for r in runs)
    return sat if newest < sat.strftime("%Y%m%d") else None


def weekday(run_dir):
    try:
        day = datetime.datetime.strptime(RUN_ID_RE.match(os.path.basename(run_dir)).group(1), "%Y%m%d")
        return WEEKDAYS[day.weekday()]
    except (AttributeError, ValueError):
        return "?"


def cmd_status(label):
    if "/" in label or label.startswith("."):
        return 0  # not a space label (the launcher never makes one)
    try:
        runs = all_runs(label)
        missed = missed_saturday(label, runs, today())
        if missed:
            print(tsv("missed", missed.isoformat()))
        # A failed run has nothing to review: it is never the run to review nor counted as waiting,
        # and is news only while it is the newest run (a later run, good or not, supersedes it).
        if runs and run_failed(runs[-1]) and not os.path.exists(os.path.join(runs[-1], "reviewed")):
            print(tsv("failed", runs[-1], weekday(runs[-1]), *(["login"] if login_expired(runs[-1]) else [])))
        waiting, any_runs = [r for r in unreviewed(runs) if not run_failed(r)], bool(runs)
        if waiting:
            line = ["review", waiting[-1], weekday(waiting[-1])]
            if len(waiting) > 1:
                line.append(f"{len(waiting) - 1} waiting")
            if os.path.exists(os.path.join(waiting[-1], PARTIAL)):
                line.append("partial")
            print(tsv(*line))
        state = wb_groom.plan_state(wb_groom.read_plan(os.path.join(plans_dir(), label)), today())
        # A missing plan is only worth a line once the space has been groomed: one that never
        # took part (no plan, no runs) or was just started from a template shows nothing.
        if state in ("due", "stale") or state == "missing" and any_runs:
            print("strategy\tdue")
    except Exception:  # noqa: BLE001  (the launcher calls this on every screen: never fail it)
        pass
    return 0


def cmd_reviewed(run_dir):
    if not os.path.isdir(run_dir):
        print(f"wb-groom: no run directory {run_dir}", file=sys.stderr)
        return 2
    try:
        with open(os.path.join(run_dir, "reviewed"), "w", encoding="utf-8") as f:
            f.write(datetime.date.today().isoformat() + "\n")
    except OSError as e:
        print(f"wb-groom: cannot mark {run_dir} reviewed: {e}", file=sys.stderr)
        return EXIT_RUN_DIR
    return 0


def cmd_strategy(label):
    spaces = read_spaces()
    if spaces is None:
        return 2
    if not any(s["label"] == label for s in spaces):
        print(f"wb-groom: no space named {label}", file=sys.stderr)
        return 2
    if "/" in label or label.startswith("."):
        print(f"wb-groom: {label}: a space label used as a folder name can't hold / or start with .", file=sys.stderr)
        return 2
    path = os.path.join(plans_dir(), label)
    if not os.path.isdir(path):
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            shutil.copytree(os.path.join(HERE, "..", "lib", "plan-templates"), path)
        except OSError as e:
            print(f"wb-groom: cannot make {path}: {e}", file=sys.stderr)
            return EXIT_RUN_DIR
    print(path)
    return 0


def options(rest, names):
    """(positionals, {name: value}) from REST, or None for a missing value or unknown option."""
    found, pos, i = {}, [], 0
    while i < len(rest):
        if rest[i] in names:
            if i + 1 >= len(rest):
                return None
            found[rest[i]] = rest[i + 1]
            i += 2
        elif rest[i].startswith("--"):
            return None
        else:
            pos.append(rest[i])
            i += 1
    return pos, found


def main(argv):
    cmd, rest = (argv[0], argv[1:]) if argv else ("", [])
    if cmd in ("ops", "apply"):
        got = options(rest, ("--plan", "--proposal") if cmd == "apply" else ("--plan",))
        if got and len(got[0]) == 2:
            (run_dir, root), opt = got
            if cmd == "ops":
                return cmd_ops(run_dir, root, opt.get("--plan"))
            number = opt.get("--proposal")
            if number is None or number.isdigit():
                return cmd_apply(run_dir, root, opt.get("--plan"), int(number) if number else None)
    elif cmd == "run":
        if len(rest) == 1 and (rest[0] == "--all" or not rest[0].startswith("-")):
            return cmd_run(rest[0])
    elif cmd == "status" and len(rest) == 1:
        return cmd_status(rest[0])
    elif cmd == "reviewed" and len(rest) == 1:
        return cmd_reviewed(rest[0])
    elif cmd == "strategy" and len(rest) == 1:
        return cmd_strategy(rest[0])
    elif cmd == "undo":
        got = options(rest, ())
        if got and len(got[0]) in (1, 2):
            return cmd_undo(got[0][0], got[0][1] if len(got[0]) == 2 else None)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

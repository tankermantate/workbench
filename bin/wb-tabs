#!/usr/bin/env python3
"""wb-tabs — every open terminal tab: what it's on, what that's for, where it stands.

  wb-tabs            prints the tabs grouped by what they need from you: waiting (with the goal
                     and next step), working, nothing pending.
  wb-tabs --waiting  prints {"total": n, "spaces": {label: n}}, for the launcher's yellow count.
  wb-tabs --rows     prints the same view as tty<TAB>line, for the launcher's list: all of a tab's
                     lines carry its tty, and headings and blank lines carry -.
  wb-tabs --jump TTY switches Apple Terminal to that tab, through osascript; exit 1 says why not.

Apart from --jump it only reads: ps, Claude's and workbench's session files, and one `bd list` per
bead store (never `bd show`, which rewrites .beads/last-touched, the target of a bare `bd close`).
Spec: docs/specs/2026-11-05-tabs-view-design.md

Exit 1: ps failed, so nothing can say which tabs are live.
"""
import concurrent.futures
import json
import os
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import wb_session  # noqa: E402  (lives in lib/; realpath, since install.sh links bin/ elsewhere)
import wb_space  # noqa: E402
from wb_live import config_dirs, pid_file, processes, tabs  # noqa: E402,F401

PS = os.environ.get("WB_PS", "ps")
OSASCRIPT = os.environ.get("WB_OSASCRIPT", "osascript")
JUMP_TIMEOUT = 60  # seconds; the first jump waits on macOS's permission dialog
FZF_GUTTER = 4  # the columns fzf keeps for itself
# the tty goes in as an argument, never into the script's text
JUMP_SCRIPT = """on run argv
  set wanted to "/dev/" & item 1 of argv
  tell application "Terminal"
    repeat with w in windows
      repeat with t in tabs of w
        if tty of t is wanted then
          set selected of t to true
          set index of w to 1
          activate
          return "found"
        end if
      end repeat
    end repeat
  end tell
  return "gone"
end run"""
BD_TIMEOUT = float(os.environ.get("WB_TABS_BD_TIMEOUT", "2"))
GOAL_MAX, NOTE_MAX, REASON_MAX, MIN_TITLE = 100, 100, 30, 20
MIN_WORDS = 5
LABEL = r"^(#+\s*|(WHY|GOAL|EPIC)\s*:\s*)"
BD_SILENT = "bead status unknown (bd didn't answer)"
BLOCKED, YOUR_TURN, WORKING, NOTHING = range(4)
SECTIONS = (("WAITING ON YOU", (BLOCKED, YOUR_TURN)), ("WORKING", (WORKING,)), ("NOTHING PENDING", (NOTHING,)))
YELLOW, RESET = "\033[33m", "\033[0m"


def cut(text, n):
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[:n - 1].rstrip() + "…"


def launched_by_workbench(pids):
    """Which of these claudes the launcher started. Only asked of the sessions with no record:
    an environment can hold secrets, so this one name is all that's looked for, and none of it
    is kept."""
    if not pids:
        return set()
    try:
        out = subprocess.run([PS, "-E", "-o", "pid=,command=", "-p", ",".join(map(str, pids))],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return set()
    return {int(m.group(1)) for m in re.finditer(r"^\s*(\d+)\s.*?(?<!\S)WB_SPACE_ROOT=", out, re.M)}


def age(seconds):
    s = max(0, int(seconds))
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= size:
            return f"{s // size}{unit}"
    return f"{s}s"


def first_sentence(text):
    """The description's first sentence that says something. One of a few words is usually
    where the bead came from ("Split from x.", "Seen on Monday."), so it's only the answer
    when nothing longer follows."""
    sentences = [" ".join(x.split()) for x in re.split(r"(?<=[.!?])\s+|\n\s*\n", str(text or "").strip())]
    sentences = [re.sub(LABEL, "", x, flags=re.I) for x in sentences if x]
    return next((x for x in sentences if len(x.split()) >= MIN_WORDS), sentences[0] if sentences else "")


def goal(bead):
    return cut(first_sentence(bead.get("description")) or "no description", GOAL_MAX)


def latest_note(bead):
    for line in reversed(str(bead.get("notes") or "").splitlines()):
        # a worktree claim line records where, not how it's going
        if line.strip() and not wb_session.WORKTREE_RE.search(line):
            return line
    return ""


def standing(session, record, bead, store):
    """(group, status text). What Claude says comes first: a real prompt is a real prompt, whatever
    the bead says. An idle session then takes its meaning from the bead, and bd outranks the record,
    since a bead can be reopened after a session closed it. If bd can't say, a tab that may be
    waiting on you stays in view."""
    def text(*parts):
        ago = session.get("statusUpdatedAt") if session else None
        ago = age(time.time() - ago / 1000) if isinstance(ago, (int, float)) else ""
        return " · ".join(x for x in (*parts, ago) if x)
    state = session.get("status") if session else None
    if state == "waiting":
        return BLOCKED, text("blocked", cut(session.get("waitingFor") or "", REASON_MAX))
    if state == "busy":
        return WORKING, text("working")
    if state != "idle":
        return NOTHING, text(str(state or "status unknown"))
    if record is None:
        return NOTHING, text("idle")
    if store is None:
        return (NOTHING, text("closed")) if record.get("done") else (YOUR_TURN, text("your turn", BD_SILENT))
    if bead is None:
        return NOTHING, text("bead not found")
    if bead.get("status") == "closed":
        return NOTHING, text("closed")
    note = "" if bead.get("status") in ("open", "in_progress") else f"bead {bead.get('status') or 'status unknown'}"
    return YOUR_TURN, text("your turn", note)


def place(session, record, spaces):
    """Where the session is. A bound session whose folder no longer says (end-session removed
    its worktree under it) still has the space it was bound in, from its record."""
    found = wb_space.locate(session["cwd"], spaces) if isinstance(session.get("cwd"), str) else None
    if record and record.get("root") and not (found and found[1]):
        return wb_space.locate(record["root"], spaces)
    return found


def place_name(found):
    if not found:
        return ""
    label, is_space, worktree = found
    return (label if is_space else f"({label})") + (" ⑂" if worktree else "")


def tab_row(pid, session, record, located, beads, launched):
    if pid is None:
        return {"group": NOTHING, "plain": True, "place": "plain shell", "id": "", "title": "", "state": "",
                "details": [], "space": None}
    store = bead = None
    if record:
        store = beads.get(wb_session.store_root(record.get("root") or "/nonexistent") or "")
        bead = store.get(record["bead"]) if store else None
    group, state = standing(session, record, bead, store)
    row = {"group": group, "plain": False, "place": place_name(located), "state": state, "details": [],
           "id": wb_session.short(record["bead"]) if record else "",
           "space": located[0] if located and located[1] else None,
           "worktree": located[2] if located else None}
    if record:
        row["title"] = (bead or {}).get("title") or record.get("title") or ""
    else:
        row["title"] = "no bead" if pid in launched else "unbound"
    if bead and group in (BLOCKED, YOUR_TURN):  # the tabs that need a decision get what it takes to make one
        row["details"] = [f"goal  {goal(bead)}", f"next  {cut(latest_note(bead), NOTE_MAX) or 'no next step recorded'}"]
    return row


def render(rows, width=None):
    """The view as (tty or -, line). On a terminal the title gives way, so the status column stays readable."""
    place_w = max(len(r["place"]) for r in rows)
    id_w = max(len(r["id"]) for r in rows)
    state_w = max(len(r["state"]) for r in rows)
    title_w = max(len(r["title"]) for r in rows)
    if width:
        title_w = min(title_w, max(MIN_TITLE, width - place_w - id_w - state_w - 8))
    lines = []
    for heading, groups in SECTIONS:
        # stable, so tabs stay in tty order within a group; a plain shell says least, so it's last
        members = sorted((r for r in rows if r["group"] in groups), key=lambda r: (r["group"], r["plain"]))
        if not members:
            continue
        if lines:
            lines.append(("-", ""))
        lines.append(("-", f"{heading} ({len(members)})"))
        for i, r in enumerate(members):
            if i and any(m["details"] for m in members):
                lines.append(("-", ""))  # three-line tabs run together without it; one-line rows don't
            title = cut(r["title"], title_w) if width else r["title"]
            lines.append((r["tty"], f"  {r['place']:<{place_w}}  {r['id']:<{id_w}}  {title:<{title_w}}  {r['state']}".rstrip()))
            lines += [(r["tty"], f"      {d}") for d in r["details"]]
    return lines


def fail(message):
    print(f"wb-tabs: {message}", file=sys.stderr)
    return 1


def jump(tty):
    if not re.fullmatch(r"ttys\d+", tty):
        return fail(f"{tty!r} is not a terminal tab.")
    if os.environ.get("TERM_PROGRAM") != "Apple_Terminal":
        return fail("jumping to a tab only works in Apple Terminal.")
    try:
        p = subprocess.run([OSASCRIPT, "-e", JUMP_SCRIPT, tty], capture_output=True, text=True, timeout=JUMP_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as e:
        return fail(f"couldn't ask Terminal to switch tabs ({e}).")
    if p.returncode:
        if "-1743" in p.stderr or "Not authorized" in p.stderr:
            return fail("Terminal isn't allowed to switch its tabs. Allow it in System Settings > "
                        "Privacy & Security > Automation.")
        return fail(f"couldn't switch tabs: {p.stderr.strip()}")
    return 0 if p.stdout.strip() == "found" else fail(f"that tab ({tty}) has closed.")


def main(argv):
    if argv[:1] == ["--jump"]:
        return jump(argv[1] if len(argv) > 1 else "")
    only_waiting, as_rows = "--waiting" in argv, "--rows" in argv
    procs = processes()
    if procs is None:
        print("wb-tabs: can't read the process table, so can't say which tabs are live.", file=sys.stderr)
        return 1
    live = tabs(procs)
    if not live:
        print(json.dumps({"total": 0, "spaces": {}}) if only_waiting
              else "-\tno open terminal tabs" if as_rows else "no open terminal tabs")
        return 0
    space_rows = wb_space.rows()
    spaces = wb_space.roots(space_rows)
    dirs = config_dirs(space_rows)
    sessions = {pid: pid_file(pid, dirs) for pid in live.values() if pid}
    records = {pid: wb_session.load(s["sessionId"]) for pid, s in sessions.items() if s}
    # the count doesn't need this, and it's the one read of another process's environment
    launched = set() if only_waiting else launched_by_workbench(
        [pid for pid in live.values() if pid and not records.get(pid)])
    stores = {r for r in (wb_session.store_root(x.get("root") or "/nonexistent")
                          for x in records.values() if x) if r}
    # one read per store, so two spaces in a repo don't contend; stores and git calls side by side,
    # so the view takes as long as its slowest store, not their sum
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(stores) + len(sessions) + 1) as pool:
        store_jobs = {s: pool.submit(wb_session.all_beads, s, BD_TIMEOUT) for s in stores}
        place_jobs = {pid: pool.submit(place, s, records.get(pid), spaces) for pid, s in sessions.items() if s}
        beads = {s: j.result() for s, j in store_jobs.items()}
        places = {pid: j.result() for pid, j in place_jobs.items()}
    rows = [dict(tab_row(live[tty], sessions.get(live[tty]), records.get(live[tty]), places.get(live[tty]),
                         beads, launched), tty=tty)
            for tty in sorted(live)]
    # two sessions in one linked worktree tread on each other's files; flag both, close neither.
    # Several in a main checkout are normal, and locate() gives those no worktree.
    shared = {}
    for r in rows:
        if r.get("worktree"):
            shared[r["worktree"]] = shared.get(r["worktree"], 0) + 1
    for r in rows:
        if shared.get(r.get("worktree"), 0) > 1:
            r["state"] = f"{r['state']} · {shared[r['worktree']]} tabs in this worktree"
    if only_waiting:
        waiting = [r for r in rows if r["group"] in (BLOCKED, YOUR_TURN)]
        counts = {}
        for r in waiting:
            if r["space"]:
                counts[r["space"]] = counts.get(r["space"], 0) + 1
        print(json.dumps({"total": len(waiting), "spaces": counts}))
        return 0
    on_terminal = sys.stdout.isatty()
    # a wrapped line would break the one-screen read; pipes get it all, and an emoji takes two cells and one len()
    width = shutil.get_terminal_size().columns - FZF_GUTTER if as_rows else \
        shutil.get_terminal_size().columns - 2 if on_terminal else None
    for tty, line in render(rows, width):
        if width and len(line) > width:
            line = line[:width - 1] + "…"
        if (on_terminal or as_rows) and line.startswith(SECTIONS[0][0]):  # fzf --ansi shows the colour too
            line = f"{YELLOW}{line}{RESET}"
        print(f"{tty}\t{line}" if as_rows else line)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

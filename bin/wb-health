#!/usr/bin/env python3
"""wb-health — one line on whether this Mac is due a restart.

  wb-health          up 162 days · swap 41 GB on 32 GB RAM · restart soon: wb-restore brings your tabs back
  wb-health --color  the same, yellow when a restart is due

Due at 30 days up, or when swap in use reaches half of RAM. Swap is measured against RAM, not
against its own total: macOS grows the swap files to fit, so used/total is always near 100%.
Whatever can't be read is left out; with nothing readable it prints nothing. Always exits 0: the
launcher shows it and must never wait on it or fail for it.
WB_BOOTTIME (epoch seconds), WB_SWAPUSAGE (sysctl vm.swapusage's text) and WB_MEMSIZE (bytes)
fake the readings. Spec: docs/specs/2026-11-15-restore-sessions-design.md
"""
import os
import re
import subprocess
import sys
import time

DUE_DAYS = 30
DUE_SWAP_OF_RAM = 0.5
GB = 1024 ** 3
YELLOW, RESET = "\033[33m", "\033[0m"


def sysctl(env, name):
    if os.environ.get(env) is not None:
        return os.environ[env]
    try:
        return subprocess.run(["sysctl", "-n", name], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def boot_time():
    text = sysctl("WB_BOOTTIME", "kern.boottime")
    m = re.fullmatch(r"\s*(\d+)\s*", text) or re.search(r"sec = (\d+)", text)
    return int(m.group(1)) if m else None


def swap_used():
    m = re.search(r"used = ([\d.]+)M", sysctl("WB_SWAPUSAGE", "vm.swapusage"))
    return float(m.group(1)) * 1024 * 1024 if m else None


def mem_size():
    m = re.fullmatch(r"\s*(\d+)\s*", sysctl("WB_MEMSIZE", "hw.memsize"))
    return int(m.group(1)) if m else None


def plural(n, unit):
    return f"{n} {unit}" + ("" if n == 1 else "s")


def uptime_text(seconds):
    for unit, size in (("day", 86400), ("hour", 3600), ("minute", 60)):
        if seconds >= size:
            return "up " + plural(int(seconds // size), unit)
    return "up " + plural(int(seconds), "second")


def health():
    """(text, due)."""
    parts, due = [], False
    boot = boot_time()
    if boot is not None:
        up = max(0, time.time() - boot)
        parts.append(uptime_text(up))
        due |= up >= DUE_DAYS * 86400
    used, mem = swap_used(), mem_size()
    if used is not None:
        parts.append(f"swap {round(used / GB)} GB" + (f" on {round(mem / GB)} GB RAM" if mem else ""))
        due |= bool(mem) and used >= mem * DUE_SWAP_OF_RAM
    if due:
        parts.append("restart soon: wb-restore brings your tabs back")
    return " · ".join(parts), due


def main(argv):
    text, due = health()
    if text:
        print(f"{YELLOW}{text}{RESET}" if due and "--color" in argv else text)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

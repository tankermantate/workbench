#!/usr/bin/env python3
"""wb-statusline-space — the status line segment naming the session's space.

  <status line JSON on stdin> | wb-statusline-space
      Acme · Acme ⑂ worktree · (folder) when no space claims it · or nothing on bad input.
      Call it from your own status line script, early on the line: it's what tells
      one terminal from another when you work across several spaces.

  <status line JSON on stdin> | wb-statusline-space --json
      {"label", "space", "worktree", "color", "emoji"}: the same, in parts, with the space's
      color from spaces.toml and its circle emoji ("" for both when unset), for tab titles.
"""
import json
import os
import subprocess
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import wb_space  # noqa: E402  (lives in lib/; realpath, since install.sh links bin/ elsewhere)

EMOJI = {"red": "🔴", "orange": "🟠", "yellow": "🟡", "green": "🟢", "blue": "🔵",
         "purple": "🟣", "brown": "🟤"}
WB_SPACES = os.path.join(os.path.dirname(os.path.realpath(__file__)), "wb-spaces")


def colors():
    try:
        out = subprocess.run([WB_SPACES, "--colors"], capture_output=True, text=True, timeout=3)
        return json.loads(out.stdout) if out.returncode == 0 else {}
    except (OSError, subprocess.SubprocessError, ValueError):
        return {}


def locate(stdin_json):
    """(label, is a space, worktree folder or None) for the session's folder, or None."""
    ws = stdin_json.get("workspace") or {}
    # project_dir is where claude was launched; current_dir drifts when a tool cd's.
    folder = ws.get("project_dir") or ws.get("current_dir") or stdin_json.get("cwd")
    return wb_space.locate(folder) if folder else None


def segment(stdin_json):
    found = locate(stdin_json)
    if not found:
        return ""
    label, space, worktree = found
    if not space:
        return f"({label})"
    return f"{label} ⑂ worktree" if worktree else label


def parts(stdin_json):
    found = locate(stdin_json)
    if not found:
        return ""
    label, space, worktree = found
    color = colors().get(label, "") if space else ""
    return json.dumps({"label": label, "space": space, "worktree": bool(worktree),
                       "color": color, "emoji": EMOJI.get(color, "")}, ensure_ascii=False)


def main(argv):
    try:
        stdin_json = json.loads(sys.stdin.read())
        out = parts(stdin_json) if argv[1:] == ["--json"] else segment(stdin_json)
    except Exception:
        return 0  # a status line must never show a traceback
    if out:
        print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

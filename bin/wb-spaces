#!/usr/bin/env python3
"""wb-spaces — this machine's spaces, from ~/.config/workbench/spaces.toml.

  wb-spaces                one TSV line per space (glob spaces: one per folder):
                           label, group, root, beads, worktrees, session_cmd,
                           space_key, claude_config, protocol, safe, gh_account,
                           on_create, before_end   ('-' = unset)
  wb-spaces --terminals    [launcher].terminals, one per line
  wb-spaces --leak-terms   private words check-leaks.sh greps for
  wb-spaces --judge-env    JSON {label: {NAME: value}}: each space's judge_env, the variables
                           its grooming judge gets beyond wb-groom's allowlist ({} when unset)
  wb-spaces --colors       JSON {label: color} for the spaces that set one (status lines, tab titles);
                           a glob space's folder_colors overrides its color folder by folder

Exit 3: no config file. Exit 4: the config is invalid. Both explain on stderr.
"""
import glob
import json
import os
import re
import sys

if sys.version_info < (3, 11):
    sys.exit("workbench: wb-spaces needs python3 >= 3.11 (for tomllib)")
import tomllib


def config_path():
    return os.environ.get("WORKBENCH_CONFIG") or os.path.expanduser("~/.config/workbench/spaces.toml")


def expand(p):
    return os.path.abspath(os.path.expanduser(p)) if p else ""


DEFAULT_SESSION_CMD = os.path.join(os.path.dirname(os.path.realpath(__file__)), "new-session")
HOOKS = ("gh_account", "on_create", "before_end")
# a fixed set: each has a circle emoji, which is all a terminal tab title can show
COLORS = ("red", "orange", "yellow", "green", "blue", "purple", "brown")
# judge_env can't move the judge onto another claude (PATH picks the binary) or another account
# (claude_config is the one way to name it).
JUDGE_ENV_RESERVED = {"PATH": "judge_env can't set PATH", "CLAUDE_CONFIG_DIR": "judge_env can't set CLAUDE_CONFIG_DIR; use claude_config"}


def judge_env(name, v):
    """A space's judge_env table, checked: names are variable names, values one-line strings."""
    if not isinstance(v, dict):
        raise ValueError(f"space '{name}': judge_env must be a table, like {{ HTTPS_PROXY = \"...\" }}")
    for k, val in v.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
            raise ValueError(f"space '{name}': judge_env: '{k}' is not a variable name")
        if k in JUDGE_ENV_RESERVED:
            raise ValueError(f"space '{name}': {JUDGE_ENV_RESERVED[k]}")
        if not isinstance(val, str):
            raise ValueError(f"space '{name}': judge_env.{k} must be a string")
        if "\n" in val or "\0" in val:
            raise ValueError(f"space '{name}': judge_env.{k} must be one line")
    return dict(v)


def color(name, v, key="color"):
    c = v.lower() if isinstance(v, str) else None
    if c not in COLORS:
        raise ValueError(f"space '{name}': {key} must be one of {', '.join(COLORS)}")
    return c


def folder_colors(name, s):
    """A glob space's folder_colors table, checked: {folder name: color}."""
    v = s["folder_colors"]
    if "glob" not in s:
        raise ValueError(f"space '{name}': folder_colors is for glob spaces; a root space sets color")
    if not isinstance(v, dict):
        raise ValueError(f"space '{name}': folder_colors must be a table, like {{ alpha = \"red\" }}")
    out = {}
    for k, c in v.items():
        if not k or "/" in k or k in (".", ".."):
            raise ValueError(f"space '{name}': folder_colors: '{k}' is not a folder name")
        out[k] = color(name, c, f"folder_colors.{k}")
    return out


def field(v):
    v = str(v).replace("\t", " ").replace("\n", " ")
    return v if v else "-"


def spaces(cfg):
    entries = cfg.get("space")
    if not isinstance(entries, list) or not entries:
        raise ValueError("no [[space]] entries")
    for n, s in enumerate(entries, 1):
        name = s.get("name")
        if not name:
            raise ValueError(f"space #{n} has no name")
        if ("root" in s) == ("glob" in s):
            raise ValueError(f"space '{name}' needs exactly one of root or glob")
        worktrees = bool(s.get("worktrees", False))
        if worktrees and "root" in s and not s.get("space_key"):
            raise ValueError(f"space '{name}' has worktrees = true but no space_key")
        if worktrees and "glob" in s and s.get("space_key"):
            raise ValueError(f"space '{name}': a glob space with worktrees = true uses each folder's "
                             "name as its key; remove space_key")
        hooks = {k: s.get(k, "") for k in HOOKS}
        for k, v in hooks.items():
            if not isinstance(v, str) or "\n" in v or "\t" in v:
                raise ValueError(f"space '{name}': {k} must be one line without tabs")
        beads = s.get("beads", "if-present")
        beads = {True: "true", False: "false"}.get(beads, beads)
        if beads not in ("true", "false", "if-present"):
            raise ValueError(f"space '{name}': beads must be true, false or \"if-present\"")
        common = {
            "beads": beads,
            "worktrees": "1" if worktrees else "0",
            "session_cmd": s.get("session_cmd", "") or (DEFAULT_SESSION_CMD if worktrees else ""),
            "space_key": s.get("space_key", ""),
            "claude_config": expand(s.get("claude_config", "")),
            "protocol": s.get("protocol", ""),
            "safe": "1" if s.get("safe") else "0",
            **hooks,
            "judge_env": judge_env(name, s.get("judge_env", {})),
            "color": color(name, s["color"]) if "color" in s else "",
        }
        # checked before the glob runs, so a bad table fails even when it lists no folders
        per_folder = folder_colors(name, s) if "folder_colors" in s else {}
        if "root" in s:
            root = expand(s["root"])
            if not os.path.isdir(root):
                print(f"workbench: skipping '{name}': {root} is not a folder", file=sys.stderr)
                continue
            yield {"label": name, "group": "", "root": root, **common}
        else:
            folders = [d for d in sorted(glob.glob(expand(s["glob"]))) if os.path.isdir(d)]
            for k in sorted(set(per_folder) - {os.path.basename(d) for d in folders}):
                # cosmetic, like a missing root: a note, not a refusal
                print(f"workbench: space '{name}': folder_colors names '{k}', which its glob doesn't list",
                      file=sys.stderr)
            for d in folders:
                base = os.path.basename(d)
                yield {"label": base, "group": name, "root": d,
                       **common, "space_key": common["space_key"] or base,
                       "color": per_folder.get(base, common["color"])}


ORDER = ("label", "group", "root", "beads", "worktrees", "session_cmd",
         "space_key", "claude_config", "protocol", "safe", "gh_account", "on_create", "before_end")


def main(argv):
    path = config_path()
    if not os.path.exists(path):
        print(f"workbench: no config at {path} — copy spaces.example.toml there to start", file=sys.stderr)
        return 3
    try:
        with open(path, "rb") as f:
            cfg = tomllib.load(f)
        launcher = cfg.get("launcher", {})
        if argv[1:] == ["--terminals"]:
            print("\n".join(launcher.get("terminals", [])))
            return 0
        rows = list(spaces(cfg))
        keys = [r["space_key"] for r in rows if r["worktrees"] == "1"]
        dup = next((k for k in keys if keys.count(k) > 1), None)
        if dup:
            raise ValueError(f"space key '{dup}' is used by more than one worktree space")
    except (tomllib.TOMLDecodeError, ValueError, TypeError, AttributeError) as e:
        print(f"workbench: invalid config {path}: {e}", file=sys.stderr)
        return 4
    if argv[1:] == ["--leak-terms"]:
        allow = {str(a).casefold() for a in launcher.get("leak_allow", [])}  # check-leaks greps -i
        terms = {r["label"] for r in rows} | {r["group"] for r in rows if r["group"]}
        terms |= {os.path.basename(r["claude_config"]) for r in rows if r["claude_config"]}
        # the folder a root names, or the folder a glob lists
        terms |= {os.path.basename(expand(s["root"]) if "root" in s else os.path.dirname(expand(s["glob"])))
                  for s in cfg["space"]}
        print("\n".join(sorted(t for t in terms if t and t.casefold() not in allow)))
        return 0
    if argv[1:] == ["--colors"]:
        print(json.dumps({r["label"]: r["color"] for r in rows if r["color"]}))
        return 0
    if argv[1:] == ["--judge-env"]:
        print(json.dumps({r["label"]: r["judge_env"] for r in rows}))
        return 0
    for r in rows:
        print("\t".join(field(r[k]) for k in ORDER))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/env python3
"""wb-session-hook — Claude Code hooks that keep a workbench session on its bead.
Spec: docs/specs/2026-10-21-session-bead-design.md

  wb-session-hook settings            the --settings JSON the launcher starts claude with
  wb-session-hook settings-file       write it to a file and print the path
  wb-session-hook session-start       bind from WB_BEAD; hand Claude the bead's goal again
  wb-session-hook post-tool-use       a bd claim or close in a Bash command
  wb-session-hook user-prompt-submit  rename the session when its bead changed

Hooks read the hook JSON on stdin. They guard nothing, so they fail silent: on
any error, exit 0 with no output, and the session carries on as if they weren't there.
"""
import json
import os
import re
import shlex
import sys

ME = os.path.realpath(__file__)
sys.path.insert(0, os.path.join(os.path.dirname(ME), "..", "lib"))
import wb_session as ws  # noqa: E402  (lives in lib/; realpath, since install.sh links bin/ elsewhere)

DESC_MAX = 1500
# by full path: bin/wb-focus is on PATH only once install.sh has linked it
FOCUS = shlex.quote(os.path.join(os.path.dirname(ME), "wb-focus"))
ASK = ("Before you start work on a different bead (claiming it or setting it in progress), "
       "ask the user whether to continue in this session or start a fresh one.")


def settings():
    def hook(sub):
        return [{"type": "command", "command": f"{shlex.quote(ME)} {sub}"}]
    # never statusLine: that would replace the user's own
    return {"hooks": {
        "SessionStart": [{"hooks": hook("session-start")}],
        "PostToolUse": [{"matcher": "Bash", "hooks": hook("post-tool-use")}],
        "UserPromptSubmit": [{"hooks": hook("user-prompt-submit")}],
    }}


def title_of(b):
    return f"{ws.short(b['bead'])} {b.get('title') or ''}".rstrip()


def out(event=None, context=None, message=None, title=None):
    o, spec = {}, {}
    if message:
        o["systemMessage"] = message
    if context:
        spec["additionalContext"] = context
    if title:
        spec["sessionTitle"] = title
    if spec:
        o["hookSpecificOutput"] = dict(hookEventName=event, **spec)
    if o:
        print(json.dumps(o, ensure_ascii=False))


def session_start(h):
    ws.prune()
    sid = h.get("session_id")
    b = ws.load(sid)
    root = (b or {}).get("root") or os.environ.get("WB_SPACE_ROOT", "")
    want = os.environ.get("WB_BEAD", "")
    bead = None
    if not b and want and root:
        bead = ws.show(root, want)
        if not bead:
            return
        b = ws.bind(sid, bead, root)
    if not b:
        return
    bead = bead or ws.show(root, b["bead"]) or {"id": b["bead"], "title": b.get("title")}
    lines = [f"This session serves bead {b['bead']}: {b.get('title') or bead.get('title') or ''}."]
    if b.get("done"):
        lines[0] += " It is closed: the session's work is done."
    desc = (bead.get("description") or "").strip()
    if desc:
        lines.append(desc[:DESC_MAX])
    if (bead.get("acceptance_criteria") or "").strip():
        lines.append("Acceptance: " + bead["acceptance_criteria"].strip())
    lines.append(ASK)
    title = None
    if b.get("named") != title_of(b):
        title = b["named"] = title_of(b)
        ws.save(sid, b)
    out("SessionStart", context="\n".join(lines), title=title)


def user_prompt_submit(h):
    sid = h.get("session_id")
    b = ws.load(sid)
    if b and b.get("named") != title_of(b):
        b["named"] = title_of(b)
        ws.save(sid, b)
        out("UserPromptSubmit", title=b["named"])


def created_id(stdout):
    m = re.search(r"Created issue: (\S+)", stdout or "")
    if m:
        return m.group(1)
    words = (stdout or "").split()
    return words[0] if len(words) == 1 else None  # bd create --silent prints just the id


def post_tool_use(h):
    resp = h.get("tool_response") if isinstance(h.get("tool_response"), dict) else {}
    if h.get("tool_name") != "Bash" or resp.get("is_error") or resp.get("interrupted"):
        return
    found = ws.parse((h.get("tool_input") or {}).get("command", ""))
    if not found:
        return
    sid = h.get("session_id")
    b = ws.load(sid)
    root = (b or {}).get("root") or os.environ.get("WB_SPACE_ROOT", "")
    if not root:
        return
    claimed, closed = [], []
    for verb, ids in found:
        if verb == "create-claim":
            ids = [i for i in [created_id(resp.get("stdout"))] if i]
        (closed if verb == "close" else claimed).extend(ids)

    msgs, ctxs = [], []
    # the bound bead closed: the session's job is done. bd show confirms it, since
    # a close bd refused (open children, say) leaves the bead as it was
    if b and not b.get("done") and b["bead"] in closed:
        bead = ws.show(root, b["bead"])
        if bead and bead.get("status") == "closed":
            b["done"] = True
            ws.save(sid, b)
            msgs.append(f"✓ {ws.short(b['bead'])} closed · this session is done")
            ctxs.append(f"This session's bead {b['bead']} is closed, so the session's work is done. "
                        "Finish the close-out (in a worktree space, run end-session once the work "
                        "is merged or pushed), then tell the user to type /exit and start the next "
                        "bead from the workbench launcher.")

    for i in claimed:
        if b and i == b["bead"] and not b.get("done"):
            continue
        bead = ws.show(root, i)
        if not bead or not ws.claimed_by_me(root, bead):
            continue  # the claim didn't take
        if not b:
            b = ws.bind(sid, bead, root)
            err = ws.note_claim(root, bead, os.environ.get("WB_WORKTREE", ""))
            msgs.append(f"→ this session is now on {title_of(b)}"
                        + (f" (claim note not written: {err})" if err else ""))
            break
        closed_note = ", which is closed" if b.get("done") else ""
        advice = "; starting fresh is recommended, since this session's bead is done" if b.get("done") else ""
        msgs.append(f"→ claimed {ws.short(i)} while this session is on {ws.short(b['bead'])}")
        ctxs.append(f"You just claimed {i}: {bead.get('title') or ''}, but this session is on "
                    f"{b['bead']}: {b.get('title') or ''}{closed_note}. "
                    f"Before working on {i}, ask the user: continue in this session (then run "
                    f"`{FOCUS} {i}`), or start fresh (run `bd update {i} --status open` and tell "
                    f"them to start {i} from the workbench launcher in a new tab){advice}.")
        break
    out("PostToolUse", message="\n".join(msgs), context="\n\n".join(ctxs))

def main(argv):
    sub = argv[1] if len(argv) > 1 else ""
    if sub == "settings":
        print(json.dumps(settings()))
        return 0
    if sub == "settings-file":
        # the launcher passes this path, not the JSON: the terminal shows the
        # command line in its window title
        p = os.path.join(ws.state_dir(), "claude-settings.json")
        os.makedirs(os.path.dirname(p), exist_ok=True)
        part = f"{p}.{os.getpid()}.part"  # its own: sessions starting at once write it together
        with open(part, "w") as f:
            f.write(json.dumps(settings()) + "\n")
        os.replace(part, p)
        print(p)
        return 0
    run = {"session-start": session_start, "post-tool-use": post_tool_use,
           "user-prompt-submit": user_prompt_submit}.get(sub)
    if not run:
        print(__doc__, file=sys.stderr)
        return 2
    try:
        h = json.loads(sys.stdin.read())
        if isinstance(h, dict):
            run(h)
    except Exception:
        pass  # fail silent: see the docstring
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
